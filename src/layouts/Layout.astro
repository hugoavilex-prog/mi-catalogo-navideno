---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "MMP | Regalos y Novedades",
  description = "Explora nuestro catálogo, arma tu lista de deseos para celebraciones y compártela con tus invitados.",
  image = "/logo.jpg"
} = Astro.props;

const ogImageUrl = Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://i.ibb.co" crossorigin />
    <link rel="dns-prefetch" href="https://i.ibb.co" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />

    <!-- Metadatos Open Graph para vista previa en WhatsApp y redes -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <slot />
  </body>
</html>