---
import Layout from '../layouts/Layout.astro';

const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS2ashxyFTq07uDvUqXXB7wYYtKFrVa_bsGbrvLg5sdRhbgEzzqo2z1kIZg8n_MTve4idf-fqRAfcz8/pub?output=csv";
const numeroWhatsApp = "51982441399";
const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzsd5kgllDfdtD_pRGTJvsx1PpHwKZWh8MBRjEru5rxfBnEWEma8rw7Yj9CPedS6BkKJQ/exec";

let productos = [];

try {
  const response = await fetch(SHEET_CSV_URL);
  const csvText = await response.text();
  const lineas = csvText.split('\n').filter(linea => linea.trim() !== '');
  
  const parseCSVLine = (linea) => {
    const valores = [];
    let enComillas = false;
    let valorActual = '';
    for (let i = 0; i < linea.length; i++) {
      const char = linea[i];
      if (char === '"') {
        enComillas = !enComillas;
      } else if (char === ',' && !enComillas) {
        valores.push(valorActual.trim().replace(/^"|"$/g, ''));
        valorActual = '';
      } else {
        valorActual += char;
      }
    }
    valores.push(valorActual.trim().replace(/^"|"$/g, ''));
    return valores;
  };

  if (lineas.length > 0) {
    const cabeceras = parseCSVLine(lineas[0]);
    productos = lineas.slice(1).map(linea => {
      const valores = parseCSVLine(linea);
      const obj = {};
      cabeceras.forEach((cabecera, i) => {
        obj[cabecera.trim()] = valores[i] ? valores[i].trim() : '';
      });
      return obj;
    });
  }

  productos = productos.filter(item => item.estado && item.estado.toLowerCase().trim() === 'activo');

  productos.sort((a, b) => {
    const catA = (a.categoria || '').toLowerCase();
    const catB = (b.categoria || '').toLowerCase();
    if (catA !== catB) return catA.localeCompare(catB);

    const getTopWeight = (topStr) => {
      const t = (topStr || '').toLowerCase().trim();
      if (t === 'top1') return 1;
      if (t === 'top2') return 2;
      if (t === 'top3') return 3;
      return 99;
    };

    const pesoA = getTopWeight(a.top);
    const pesoB = getTopWeight(b.top);
    if (pesoA !== pesoB) return pesoA - pesoB;

    const codigoA = (a.codigo || a.id || '').toLowerCase();
    const codigoB = (b.codigo || b.id || '').toLowerCase();
    return codigoA.localeCompare(codigoB);
  });

} catch (error) {
  console.error("Error al cargar Google Sheets:", error);
}
---

<Layout title="MMP | Regalos y Novedades">
  <!-- Banner superior para invitados -->
  <div id="banner-invitado" class="bg-amber-500 text-slate-950 font-bold text-xs py-2 px-4 text-center hidden shadow-sm sticky top-0 z-50 flex items-center justify-center gap-2">
    <span>🎁 Estás viendo la lista de regalos de <span id="banner-nombre-cumple" class="underline">---</span></span>
    <button type="button" id="btn-salir-modo-invitado" class="bg-slate-950 text-white px-2 py-0.5 rounded text-[10px] ml-4 cursor-pointer hover:bg-slate-800">Salir / Ver Catálogo General</button>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-45 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-2 md:gap-4">
      <div class="flex items-center gap-2 shrink-0">
        <!-- Logo de la marca -->
        <a href="/" class="flex items-center gap-2">
          <img src="/logo.jpg" alt="MMP Tienda Online" class="h-14 md:h-16 w-auto object-contain rounded-md" />
        </a>
      </div>
      
      <div class="flex-1 max-w-md">
        <input 
          type="text" 
          id="input-buscador" 
          placeholder="🔍 Buscar producto..." 
          class="w-full bg-gray-50 text-gray-800 text-xs md:text-sm px-4 py-2 rounded-full border border-gray-200 focus:outline-none focus:border-red-600 shadow-xs"
        />
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button 
          id="btn-abrir-menu-lista" 
          class="bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs md:text-sm font-semibold px-3 py-2 rounded-full transition-colors cursor-pointer shadow-xs flex items-center gap-1"
        >
          🎁 Arma tu Lista / Seguimiento
        </button>

        <a 
          href={`https://wa.me/${numeroWhatsApp}?text=Hola,%20quisiera%20más%20información%20sobre%20el%20catálogo.`} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs md:text-sm font-medium px-3 md:px-4 py-2 rounded-full transition-colors shadow-xs flex items-center gap-1.5"
        >
          💬 WhatsApp
        </a>
      </div>
    </div>
  </header>

  <!-- Banner Principal con Contador Navideño -->
  <section class="bg-gradient-to-r from-red-900 via-rose-950 to-slate-900 text-white py-8 md:py-10 px-4 text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto space-y-3 relative z-10">
      <span class="bg-red-500/30 text-red-200 text-xs font-semibold px-3 py-1 rounded-full border border-red-500/40">✨ Envíos a Todo el Perú</span>
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight">MMP - Regalos y Novedades</h1>
      <p class="text-gray-200 text-xs md:text-sm">Explora nuestros productos, arma tu lista de celebración o haz seguimiento a tus regalos con tu código secreto.</p>
      
      <!-- Contador Regresivo para Navidad -->
      <div id="contador-navidad" class="pt-2 flex justify-center items-center gap-2 md:gap-4 text-center">
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="dias" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Días</span>
        </div>
        <span class="text-lg font-bold text-red-400">:</span>
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="horas" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Horas</span>
        </div>
        <span class="text-lg font-bold text-red-400">:</span>
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="minutos" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Min</span>
        </div>
        <span class="text-lg font-bold text-red-400">:</span>
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="segundos" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Seg</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo -->
  <main class="max-w-6xl mx-auto px-2 md:px-4 py-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 px-2">
      <div>
        <h2 class="text-lg md:text-xl font-bold text-gray-900">Productos Disponibles</h2>
        <span class="text-xs md:text-sm text-gray-500" id="contador-productos">{productos.length} productos en stock</span>
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap gap-2" id="filtros-container">
        <button data-filtro="todos" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-red-700 text-white transition-colors cursor-pointer shadow-xs">Todos</button>
        <button data-filtro="Juguetes" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">Juguetes</button>
        <button data-filtro="Regalos" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">Regalos</button>
        <button data-filtro="Ropa" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">Ropa</button>
        <button data-filtro="Muebles" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">Muebles</button>
        <button data-filtro="Carteras" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">Carteras</button>
        <button data-filtro="Oferta" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors cursor-pointer">🔥 Ofertas</button>
        <button data-filtro="Nuevo" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors cursor-pointer">✨ Nuevos</button>
        <button data-filtro="Tendencia" class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors cursor-pointer">⭐ Tendencia</button>
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6" id="grid-productos">
      {productos.map((item, index) => {
        const precioNum = parseFloat(item.precio) || 0;
        const mensajeWp = encodeURIComponent(`Hola, me interesa "${item.nombre}" de S/ ${precioNum.toFixed(2)} visto en la web.`);
        const linkWp = `https://wa.me/${numeroWhatsApp}?text=${mensajeWp}`;
        const descripcionSegura = item.descripcion || "Producto importado de alta calidad con garantía.";

        const fotosGaleria = item.galeria 
          ? item.galeria.split(',').map(f => f.trim()).filter(f => f.length > 5 && f.startsWith('http')) 
          : [];
        
        const todasLasFotos = [item.imagen, ...fotosGaleria];
        const uniqueId = `prod-${index}`;
        const tieneVideo = item.video && item.video.trim().length > 5;
        const productId = item.id || item.codigo || `p-${index}`;

        return (
          <div 
            class="producto-card bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between"
            data-nombre={item.nombre ? item.nombre.toLowerCase() : ''}
            data-tags={item.tags ? item.tags.toLowerCase() : ''}
            data-categoria={item.categoria ? item.categoria.toLowerCase() : ''}
            data-badge={item.badge ? item.badge.toLowerCase() : ''}
          >
            <div>
              <div 
                class="relative bg-gray-50 aspect-square overflow-hidden flex flex-col justify-between p-2 cursor-pointer btn-detalle group"
                data-nombre={item.nombre}
                data-desc={descripcionSegura}
                data-precio={`S/ ${precioNum.toFixed(2)}`}
                data-imagen={item.imagen}
                data-id={productId}
              >
                <div class="w-full h-full absolute inset-0 bg-gray-50 flex items-center justify-center p-2">
                  <img 
                    src={item.imagen} 
                    alt={item.nombre} 
                    class="imagen-principal object-contain w-full h-full pointer-events-none group-hover:scale-105 transition-transform duration-300"
                    id={`img-${uniqueId}`}
                    loading="lazy"
                  />
                </div>

                {tieneVideo && (
                  <a 
                    href={item.video} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation()"
                    class="absolute bottom-2 left-2 z-20 bg-red-600 hover:bg-red-700 text-white p-2 rounded-full shadow-md transition-transform hover:scale-110 flex items-center justify-center"
                    title="Ver video"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </a>
                )}

                {item.badge && (
                  <span class="absolute top-2 left-2 z-10 bg-red-600 text-white text-[9px] md:text-xs font-bold px-1.5 py-0.5 rounded shadow-xs pointer-events-none">
                    {item.badge}
                  </span>
                )}

                {todasLasFotos.length > 1 && (
                  <div class="relative z-10 mt-auto flex gap-1 bg-black/50 backdrop-blur-md p-1 rounded overflow-x-auto" onclick="event.stopPropagation()">
                    {todasLasFotos.map((fotoUrl, fotoIdx) => (
                      <button 
                        type="button"
                        class={`minifoto-btn w-6 h-6 rounded overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${fotoIdx === 0 ? 'border-red-500 scale-105' : 'border-white/50 hover:border-white'}`}
                        data-target={`img-${uniqueId}`}
                        data-url={fotoUrl}
                      >
                        <img src={fotoUrl} alt="" class="w-full h-full object-cover" />
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <div class="p-2 md:p-3 flex flex-col space-y-1">
                <span class="text-[9px] md:text-xs font-semibold text-red-600 uppercase tracking-wider">{item.categoria}</span>
                <h3 class="text-xs md:text-sm font-semibold text-gray-900 line-clamp-2 leading-tight">{item.nombre}</h3>
                
                {item.medidas && (
                  <p class="text-[9px] md:text-xs text-gray-500 bg-gray-50 px-1.5 py-0.5 rounded border border-gray-100 inline-block">
                    📏 {item.medidas}
                  </p>
                )}
              </div>
            </div>

            <div class="p-2 md:p-3 pt-0 flex flex-col space-y-1.5">
              <div class="flex items-baseline justify-between border-t border-gray-50 pt-1.5">
                <span class="text-xs md:text-base font-bold text-gray-900">S/ {precioNum.toFixed(2)}</span>
                {item.precioAnterior && (
                  <span class="text-[9px] md:text-xs text-gray-400 line-through">S/ {parseFloat(item.precioAnterior).toFixed(2)}</span>
                )}
              </div>

              <div class="grid grid-cols-2 gap-1 pt-1">
                <button 
                  type="button"
                  class="btn-detalle bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-[9px] md:text-xs py-1.5 rounded-lg transition-colors text-center cursor-pointer"
                  data-nombre={item.nombre}
                  data-desc={descripcionSegura}
                  data-precio={`S/ ${precioNum.toFixed(2)}`}
                  data-imagen={item.imagen}
                  data-id={productId}
                >
                  🔍 Detalle
                </button>

                <a 
                  href={linkWp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-[9px] md:text-xs py-1.5 rounded-lg text-center transition-colors shadow-xs flex items-center justify-center"
                >
                  WhatsApp
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </main>

  <!-- Footer -->
  <footer class="mt-20 border-t border-gray-200 bg-slate-900 text-gray-200 py-6 text-center text-xs">
    <p>MMP - Todos los derechos reservados.</p>
  </footer>

  <!-- Modal Detalle -->
  <div id="modal-detalle" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 relative shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <button id="cerrar-modal-btn" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold cursor-pointer z-10 bg-gray-100 w-8 h-8 rounded-full flex items-center justify-center">✕</button>
      
      <div id="zoom-container" class="w-full h-72 md:h-80 bg-gray-50 rounded-xl overflow-hidden flex items-center justify-center p-2 relative group cursor-grab active:cursor-grabbing select-none">
        <img id="modal-img" src="" alt="" class="max-w-full max-h-full object-contain transition-transform duration-75 origin-center" />
        
        <div class="absolute top-3 left-3 z-20" id="contenedor-btn-accion-modal">
          <button type="button" id="btn-agregar-desde-detalle" class="bg-pink-600 hover:bg-pink-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow-md transition-colors cursor-pointer flex items-center gap-1">
            ❤️ Agregar a tu Lista
          </button>
        </div>

        <div class="absolute bottom-3 right-3 z-20 flex items-center gap-1 bg-black/60 backdrop-blur-md p-1 rounded-lg text-white shadow-md">
          <button type="button" id="zoom-out-btn" class="w-7 h-7 bg-white/20 hover:bg-white/40 rounded flex items-center justify-center font-bold text-sm cursor-pointer">-</button>
          <span id="zoom-nivel" class="text-[10px] px-1 font-mono">100%</span>
          <button type="button" id="zoom-in-btn" class="w-7 h-7 bg-white/20 hover:bg-white/40 rounded flex items-center justify-center font-bold text-sm cursor-pointer">+</button>
          <button type="button" id="zoom-reset-btn" class="w-7 h-7 bg-white/20 hover:bg-white/40 rounded flex items-center justify-center font-bold text-xs cursor-pointer">↺</button>
        </div>
      </div>
      <p class="text-[10px] text-gray-400 text-center">💡 Haz clic en [+] para acercar y arrastra la imagen para moverte.</p>

      <div>
        <span id="modal-precio" class="text-emerald-600 font-bold text-xl"></span>
        <h3 id="modal-titulo" class="text-xl font-bold text-gray-900 mt-1"></h3>
      </div>
      <p id="modal-desc" class="text-gray-600 text-sm leading-relaxed whitespace-pre-line"></p>
      <div class="pt-2">
        <button id="cerrar-modal-footer" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm py-2.5 rounded-xl transition-colors cursor-pointer">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Menú / Drawer Principal -->
  <div id="drawer-menu-lista" class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col">
    <div class="bg-red-700 text-white p-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">🎁</span>
        <h3 class="font-bold text-sm">Gestión de Listas y Regalos</h3>
      </div>
      <button id="cerrar-drawer-menu" class="text-red-200 hover:text-white text-lg font-bold cursor-pointer">✕</button>
    </div>

    <div class="p-6 space-y-6 flex-1 overflow-y-auto">
      <!-- Opción 1: Crear Nueva Lista -->
      <div class="bg-red-50 border border-red-200 p-4 rounded-xl space-y-2">
        <h4 class="font-bold text-sm text-red-800">✨ Crear una nueva lista de deseos</h4>
        <p class="text-xs text-gray-600">Llena tu formulario directamente para obtener tu código secreto y enlace para compartir.</p>
        <button type="button" id="btn-abrir-registro" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold text-xs py-2.5 rounded-lg transition-colors cursor-pointer shadow-xs">
          Completar Datos del Cumpleañero
        </button>
      </div>

      <!-- Opción 2: Seguimiento con Código de 6 Dígitos -->
      <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-3">
        <h4 class="font-bold text-sm text-slate-800">🔍 ¿Ya cuentas con una lista?</h4>
        <p class="text-xs text-gray-600">Ingresa tu código secreto de 6 dígitos para administrar tu lista o ver tus regalos.</p>
        <div class="flex gap-2">
          <input type="text" id="input-codigo-seguimiento" placeholder="Ej: 482195" maxlength="6" class="flex-1 bg-white text-xs px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:border-red-600 font-mono tracking-widest text-center" />
          <button type="button" id="btn-consultar-seguimiento" class="bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs px-4 py-2 rounded-lg cursor-pointer">Ingresar</button>
        </div>
      </div>

      <!-- Panel de la Lista Activa del Papá -->
      <div id="seccion-lista-activa" class="space-y-3 pt-4 border-t border-gray-100 hidden">
        <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl flex items-center justify-between">
          <div>
            <span class="text-[10px] font-bold text-emerald-800 uppercase">Estás administrando la lista:</span>
            <p id="lbl-lista-activa-nombre" class="text-xs font-bold text-emerald-900">---</p>
          </div>
          <button type="button" id="btn-cerrar-sesion-lista" class="text-[10px] bg-red-100 hover:bg-red-200 text-red-700 px-2 py-1 rounded font-semibold cursor-pointer">Cerrar Sesión</button>
        </div>
        <p class="text-[11px] text-gray-500">Haz clic en los botones de abajo para revisar los regalos o reenviar tu enlace por WhatsApp.</p>
      </div>
    </div>
  </div>

  <!-- Modal de Registro Directo (Formulario) -->
  <div id="modal-registro-cumple" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 relative shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">🎂 Datos para la Lista de Deseos</h3>
      
      <form id="form-cumpleanero" class="space-y-3">
        <div>
          <label class="block text-[11px] font-semibold text-gray-700 mb-1">Nombres del Niño(a):</label>
          <input type="text" id="reg-nombre" required placeholder="Ej: Luciana Valentina" class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[11px] font-semibold text-gray-700 mb-1">Apellido Paterno:</label>
            <input type="text" id="reg-pat" required placeholder="Ej: Suárez" class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-gray-700 mb-1">Apellido Materno:</label>
            <input type="text" id="reg-mat" required placeholder="Ej: Pérez" class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-[11px] font-semibold text-gray-700 mb-1">Fecha de Nacimiento:</label>
            <input type="date" id="reg-fechacumple" required class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-gray-700 mb-1">Fecha de Celebración:</label>
            <input type="date" id="reg-fechafiesta" required class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-gray-700 mb-1">Celular de Contacto (WhatsApp):</label>
          <input type="tel" id="reg-celular" required placeholder="Ej: 982441399" class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-gray-700 mb-1">Correo Principal:</label>
          <input type="email" id="reg-correoprincipal" required placeholder="tuemail@gmail.com" class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-gray-700 mb-1">Correo Secundario (Opcional):</label>
          <input type="email" id="reg-correosecundario" placeholder="segundoemail@gmail.com" class="w-full bg-gray-50 text-xs px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:border-red-600" />
        </div>

        <div class="flex gap-2 pt-3">
          <button type="button" id="btn-cancelar-registro" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs py-2.5 rounded-xl font-medium cursor-pointer">Cancelar</button>
          <button type="submit" class="flex-1 bg-red-700 hover:bg-red-800 text-white text-xs py-2.5 rounded-xl font-bold cursor-pointer shadow-sm">Crear Lista</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de Éxito -->
  <div id="modal-exito-lista" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 relative shadow-2xl space-y-4 text-center">
      <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">🎉</div>
      <h3 class="text-lg font-bold text-gray-900">¡Lista Creada con Éxito!</h3>
      
      <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl space-y-1">
        <p class="text-[11px] text-amber-800 font-semibold">Tu Código Secreto de 6 Dígitos:</p>
        <span id="codigo-generado" class="text-xl font-black text-amber-900 tracking-wider font-mono">---</span>
      </div>

      <div class="space-y-2">
        <label class="block text-[11px] font-semibold text-gray-700">Enlace para compartir con invitados:</label>
        <div class="flex gap-1">
          <input type="text" id="input-enlace-compartir" readonly class="w-full bg-gray-50 text-[10px] px-2 py-1.5 rounded-lg border border-gray-300 font-mono text-center" />
          <button type="button" id="btn-copiar-enlace" class="bg-slate-900 hover:bg-slate-800 text-white text-xs px-3 py-1.5 rounded-lg font-bold cursor-pointer shrink-0">📋 Copiar</button>
        </div>
      </div>

      <button id="btn-empezar-agregar" class="w-full bg-red-700 hover:bg-red-800 text-white text-xs py-3 rounded-xl font-bold cursor-pointer shadow-sm">
        🎁 Empieza a agregar regalos a tu lista
      </button>
    </div>
  </div>

  <script define:vars={{ APPS_SCRIPT_URL, numeroWhatsApp }}>
    // --- CONTADOR REGRESIVO PARA NAVIDAD ---
    function actualizarContadorNavidad() {
      const ahora = new Date();
      let anioActual = ahora.getFullYear();
      let navidad = new Date(anioActual, 11, 25, 0, 0, 0);

      if (ahora.getTime() > navidad.getTime()) {
        navidad = new Date(anioActual + 1, 11, 25, 0, 0, 0);
      }

      const diferencia = navidad.getTime() - ahora.getTime();
      const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
      const horas = Math.floor((diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
      const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

      const elDias = document.getElementById('dias');
      const elHoras = document.getElementById('horas');
      const elMinutos = document.getElementById('minutos');
      const elSegundos = document.getElementById('segundos');

      if (elDias) elDias.textContent = String(dias).padStart(2, '0');
      if (elHoras) elHoras.textContent = String(horas).padStart(2, '0');
      if (elMinutos) elMinutos.textContent = String(minutos).padStart(2, '0');
      if (elSegundos) elSegundos.textContent = String(segundos).padStart(2, '0');
    }

    setInterval(actualizarContadorNavidad, 1000);
    actualizarContadorNavidad();

    // Filtros y Buscador
    const botonesFiltro = document.querySelectorAll('.filtro-btn');
    const tarjetasProductos = document.querySelectorAll('.producto-card');
    const contadorProductos = document.getElementById('contador-productos');
    const inputBuscador = document.getElementById('input-buscador');

    let categoriaActiva = 'todos';
    let textoBusqueda = '';

    function aplicarFiltros() {
      let visibles = 0;
      tarjetasProductos.forEach(card => {
        if (card.style.display === 'none' && card.dataset.modoInvitadoOculto) return;
        
        const categoriaCard = card.getAttribute('data-categoria') || '';
        const badgeCard = card.getAttribute('data-badge') || '';
        const nombreCard = card.getAttribute('data-nombre') || '';
        const tagsCard = card.getAttribute('data-tags') || '';

        const coincideCategoria = (
          categoriaActiva === 'todos' || 
          categoriaCard.includes(categoriaActiva.toLowerCase()) || 
          badgeCard.includes(categoriaActiva.toLowerCase())
        );

        const coincideTexto = (
          nombreCard.includes(textoBusqueda) || 
          tagsCard.includes(textoBusqueda)
        );

        if (coincideCategoria && coincideTexto) {
          card.style.display = 'flex';
          visibles++;
        } else {
          card.style.display = 'none';
        }
      });

      if (contadorProductos) {
        contadorProductos.textContent = `${visibles} productos visibles`;
      }
    }

    botonesFiltro.forEach(boton => {
      boton.addEventListener('click', () => {
        botonesFiltro.forEach(b => {
          b.classList.remove('bg-red-700', 'text-white');
          b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        });
        boton.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'text-red-600', 'border-red-200');
        boton.classList.add('bg-red-700', 'text-white');

        categoriaActiva = boton.getAttribute('data-filtro') || 'todos';
        aplicarFiltros();
      });
    });

    if (inputBuscador) {
      inputBuscador.addEventListener('input', (e) => {
        textoBusqueda = e.target.value.toLowerCase().trim();
        aplicarFiltros();
      });
    }

    // Galería interactiva
    document.querySelectorAll('.minifoto-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-target');
        const nuevaUrl = btn.getAttribute('data-url');
        
        const imagenPrincipal = document.getElementById(targetId);
        if (imagenPrincipal) imagenPrincipal.setAttribute('src', nuevaUrl);

        const card = btn.closest('.producto-card');
        const btnDetalle = card?.querySelector('.btn-detalle');
        if (btnDetalle) btnDetalle.setAttribute('data-imagen', nuevaUrl);
      });
    });

    // --- ZOOM MANUAL ---
    const modalDetalle = document.getElementById('modal-detalle');
    const modalTitulo = document.getElementById('modal-titulo');
    const modalDesc = document.getElementById('modal-desc');
    const modalPrecio = document.getElementById('modal-precio');
    const modalImg = document.getElementById('modal-img');
    const zoomContainer = document.getElementById('zoom-container');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomResetBtn = document.getElementById('zoom-reset-btn');
    const zoomNivelSpan = document.getElementById('zoom-nivel');
    const btnAgregarDesdeDetalle = document.getElementById('btn-agregar-desde-detalle');

    let escalaActual = 1;
    let posX = 0;
    let posY = 0;
    let arrastrando = false;
    let inicioX = 0;
    let inicioY = 0;
    let productoActualModal = null;

    function actualizarTransformacion() {
      if (modalImg) modalImg.style.transform = `translate(${posX}px, ${posY}px) scale(${escalaActual})`;
      if (zoomNivelSpan) zoomNivelSpan.textContent = `${Math.round(escalaActual * 100)}%`;
    }

    function resetZoomPan() {
      escalaActual = 1;
      posX = 0;
      posY = 0;
      actualizarTransformacion();
    }

    zoomInBtn?.addEventListener('click', () => { if (escalaActual < 3) { escalaActual += 0.5; actualizarTransformacion(); } });
    zoomOutBtn?.addEventListener('click', () => { if (escalaActual > 1) { escalaActual -= 0.5; if (escalaActual === 1) { posX = 0; posY = 0; } actualizarTransformacion(); } });
    zoomResetBtn?.addEventListener('click', resetZoomPan);

    zoomContainer?.addEventListener('mousedown', (e) => {
      if (escalaActual > 1) {
        arrastrando = true;
        inicioX = e.clientX - posX;
        inicioY = e.clientY - posY;
        zoomContainer.style.cursor = 'grabbing';
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!arrastrando) return;
      posX = e.clientX - inicioX;
      posY = e.clientY - inicioY;
      actualizarTransformacion();
    });

    window.addEventListener('mouseup', () => { arrastrando = false; if (zoomContainer) zoomContainer.style.cursor = 'grab'; });

    document.querySelectorAll('.btn-detalle').forEach(btn => {
      btn.addEventListener('click', () => {
        const nombre = btn.getAttribute('data-nombre') || '';
        const desc = btn.getAttribute('data-desc') || '';
        const precio = btn.getAttribute('data-precio') || '';
        const productId = btn.getAttribute('data-id') || '';
        
        if (modalTitulo) modalTitulo.innerText = nombre;
        if (modalDesc) modalDesc.innerText = desc;
        if (modalPrecio) modalPrecio.innerText = precio;
        
        const card = btn.closest('.producto-card');
        const imgCard = card?.querySelector('.imagen-principal');
        const imagenUrl = imgCard ? imgCard.src : (btn.getAttribute('data-imagen') || '');
        if (modalImg) modalImg.src = imagenUrl;

        productoActualModal = {
          id: productId,
          nombre: nombre,
          precio: parseFloat(precio.replace('S/', '').trim()) || 0,
          imagen: imagenUrl
        };

        const listaActiva = JSON.parse(localStorage.getItem('mmp_lista_activa') || 'null');
        const modoInvitado = localStorage.getItem('mmp_modo_invitado');

        if (btnAgregarDesdeDetalle) {
          if (modoInvitado) {
            btnAgregarDesdeDetalle.textContent = '👀 Regalo de la Lista (Solo Consulta)';
            btnAgregarDesdeDetalle.className = 'bg-slate-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow-md cursor-default';
            btnAgregarDesdeDetalle.disabled = true;
          } else if (listaActiva) {
            btnAgregarDesdeDetalle.textContent = '❤️ Agregar a tu Lista';
            btnAgregarDesdeDetalle.className = 'bg-pink-600 hover:bg-pink-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow-md transition-colors cursor-pointer flex items-center gap-1';
            btnAgregarDesdeDetalle.disabled = false;
          } else {
            btnAgregarDesdeDetalle.textContent = '⚠️ Crea o ingresa a una lista primero';
            btnAgregarDesdeDetalle.className = 'bg-gray-500 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow-md cursor-not-allowed';
            btnAgregarDesdeDetalle.disabled = true;
          }
        }

        resetZoomPan();
        modalDetalle?.classList.remove('hidden');
        modalDetalle?.classList.add('flex');
      });
    });

    btnAgregarDesdeDetalle?.addEventListener('click', async () => {
      const modoInvitado = localStorage.getItem('mmp_modo_invitado');
      if (modoInvitado) return;

      const listaActiva = JSON.parse(localStorage.getItem('mmp_lista_activa') || 'null');
      if (!listaActiva) {
        alert("Primero debes crear una lista o ingresar con tu código secreto de 6 dígitos.");
        return;
      }

      try {
        const response = await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({
            accion: "agregar_item_lista",
            id_lista: listaActiva.id_lista,
            item: productoActualModal
          })
        });
        const res = await response.json();
        if (res.result === "success") {
          alert(`¡"${productoActualModal.nombre}" añadido a tu lista de deseos con éxito!`);
        } else if (res.result === "duplicado") {
          alert("⚠️ Este producto ya se encuentra registrado en tu lista.");
        } else {
          alert("Error al agregar el producto: " + res.message);
        }
      } catch (err) {
        console.error(err);
        alert("Error de conexión al agregar el producto.");
      }
    });

    function cerrarModalDetalle() {
      modalDetalle?.classList.remove('flex');
      modalDetalle?.classList.add('hidden');
    }

    document.getElementById('cerrar-modal-btn')?.addEventListener('click', cerrarModalDetalle);
    document.getElementById('cerrar-modal-footer')?.addEventListener('click', cerrarModalDetalle);
    modalDetalle?.addEventListener('click', (e) => { if (e.target === modalDetalle) cerrarModalDetalle(); });

    // --- GESTIÓN DE LISTAS Y SEGUIMIENTO ---
    const btnAbrirMenuLista = document.getElementById('btn-abrir-menu-lista');
    const drawerMenuLista = document.getElementById('drawer-menu-lista');
    const cerrarDrawerMenu = document.getElementById('cerrar-drawer-menu');
    
    const modalRegistroCumple = document.getElementById('modal-registro-cumple');
    const btnAbrirRegistro = document.getElementById('btn-abrir-registro');
    const btnCancelarRegistro = document.getElementById('btn-cancelar-registro');
    const formCumpleanero = document.getElementById('form-cumpleanero');
    
    const modalExitoLista = document.getElementById('modal-exito-lista');
    const codigoGeneradoSpan = document.getElementById('codigo-generado');
    const inputEnlaceCompartir = document.getElementById('input-enlace-compartir');
    const btnCopiarEnlace = document.getElementById('btn-copiar-enlace');
    const btnEmpezarAgregar = document.getElementById('btn-empezar-agregar');

    const inputCodigoSeguimiento = document.getElementById('input-codigo-seguimiento');
    const btnConsultarSeguimiento = document.getElementById('btn-consultar-seguimiento');

    const seccionListaActiva = document.getElementById('seccion-lista-activa');
    const lblListaActivaNombre = document.getElementById('lbl-lista-activa-nombre');
    const btnCerrarSesionLista = document.getElementById('btn-cerrar-sesion-lista');

    window.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const idListaUrl = urlParams.get('lista');

      if (idListaUrl) {
        try {
          const response = await fetch(APPS_SCRIPT_URL, {
            method: "POST",
            body: JSON.stringify({ accion: "consultar_por_id", id_lista: idListaUrl })
          });
          const res = await response.json();
          if (res.result === "success" && res.lista) {
            localStorage.setItem('mmp_modo_invitado', JSON.stringify(res.lista));
            document.getElementById('banner-invitado')?.classList.remove('hidden');
            document.getElementById('banner-nombre-cumple').textContent = res.lista.nombre_nino;
            
            await filtrarCatalogoParaInvitado(res.lista.id_lista);
          }
        } catch (e) {
          console.error("Error cargando lista de invitado", e);
        }
      } else {
        const listaActiva = JSON.parse(localStorage.getItem('mmp_lista_activa') || 'null');
        if (listaActiva) {
          if (seccionListaActiva) seccionListaActiva.classList.remove('hidden');
          if (lblListaActivaNombre) lblListaActivaNombre.textContent = `Lista de ${listaActiva.nombreNino} (${listaActiva.id_lista})`;
          
          const drawerContent = document.querySelector('#drawer-menu-lista .overflow-y-auto');
          if (drawerContent && !document.getElementById('btn-ver-mi-lista-papa')) {
            const divPapa = document.createElement('div');
            divPapa.className = "space-y-2 mt-3";
            divPapa.innerHTML = `
              <button id="btn-ver-mi-lista-papa" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-2.5 rounded-lg transition-colors cursor-pointer shadow-xs">
                📋 Seguimiento: Ver Quién Reservó mis Regalos
              </button>
              <a id="btn-whatsapp-enlace" href="#" target="_blank" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2.5 rounded-lg transition-colors shadow-xs flex items-center justify-center gap-1">
                💬 Reenviar Enlace por WhatsApp
              </a>
            `;
            drawerContent.appendChild(divPapa);

            const enlaceActualCompartir = `${window.location.origin}${window.location.pathname}?lista=${listaActiva.id_lista}`;
            const textoWp = encodeURIComponent(`¡Hola! Aquí te comparto la lista de regalos de ${listaActiva.nombreNino} en MMP: ${enlaceActualCompartir}`);
            document.getElementById('btn-whatsapp-enlace').href = `https://wa.me/${numeroWhatsApp}?text=${textoWp}`;

            document.getElementById('btn-ver-mi-lista-papa').addEventListener('click', async () => {
              drawerMenuLista?.classList.add('translate-x-full');
              await abrirModalSeguimientoPapa(listaActiva.id_lista, listaActiva.nombreNino);
            });
          }
        }
      }
    });

    // Vista de Invitado: SOLO ve Disponible / Reservado (SIN MOSTRAR EL NOMBRE DE QUIÉN LO COMPRÓ)
    async function filtrarCatalogoParaInvitado(idLista) {
      try {
        const response = await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({ accion: "obtener_items_lista", id_lista: idLista })
        });
        const res = await response.json();
        if (res.result === "success") {
          const itemsLista = res.items || [];
          const idsPermitidos = itemsLista.map(i => String(i.id_producto).trim());

          tarjetasProductos.forEach(card => {
            const btnDetalle = card.querySelector('.btn-detalle');
            const prodId = btnDetalle?.getAttribute('data-id') || '';
            
            if (idsPermitidos.includes(String(prodId).trim())) {
              card.style.display = 'flex';
              card.dataset.modoInvitadoOculto = "";
              
              const itemInfo = itemsLista.find(i => String(i.id_producto).trim() === String(prodId).trim());
              const contenedorImg = card.querySelector('.relative');
              
              if (itemInfo) {
                let etiquetaEstado = card.querySelector('.etiqueta-estado-invitado');
                if (!etiquetaEstado) {
                  etiquetaEstado = document.createElement('div');
                  etiquetaEstado.className = 'etiqueta-estado-invitado absolute inset-x-0 bottom-0 z-30 py-2 px-1 text-center font-black text-xs md:text-sm shadow-lg uppercase tracking-wider';
                  contenedorImg.appendChild(etiquetaEstado);
                }

                if (itemInfo.estado === "Reservado") {
                  etiquetaEstado.className = 'etiqueta-estado-invitado absolute inset-x-0 bottom-0 z-30 py-2.5 px-1 text-center font-black text-xs md:text-sm shadow-lg uppercase tracking-wider bg-red-600 text-white animate-pulse';
                  etiquetaEstado.textContent = `❌ RESERVADO`;
                } else {
                  etiquetaEstado.className = 'etiqueta-estado-invitado absolute inset-x-0 bottom-0 z-30 py-2 px-1 text-center font-black text-xs md:text-sm shadow-lg uppercase tracking-wider bg-emerald-600 text-white';
                  etiquetaEstado.textContent = `✔️ DISPONIBLE EN LISTA`;
                }
              }
            } else {
              card.style.display = 'none';
              card.dataset.modoInvitadoOculto = "true";
            }
          });

          if (contadorProductos) {
            contadorProductos.textContent = `${idsPermitidos.length} regalos únicos en la lista`;
          }
        }
      } catch (err) {
        console.error("Error filtrando catálogo para invitado", err);
      }
    }

    // Vista de Seguimiento del Papá: AQUÍ SÍ VE QUIÉN RESERVÓ
    async function abrirModalSeguimientoPapa(idLista, nombreNino) {
      try {
        const response = await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({ accion: "obtener_items_lista", id_lista: idLista })
        });
        const res = await response.json();
        if (res.result === "success") {
          const items = res.items || [];
          
          let contenidoHtml = `
            <div id="modal-ver-propia" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
              <div class="bg-white rounded-2xl max-w-lg w-full p-6 relative shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
                <button id="cerrar-modal-propia" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold cursor-pointer">✕</button>
                <h3 class="text-lg font-bold text-gray-900">🎁 Seguimiento: Regalos de ${nombreNino}</h3>
                <p class="text-xs text-gray-500">ID de Lista: <b>${idLista}</b></p>
                
                <div class="space-y-3 divide-y divide-gray-100">
          `;

          if (items.length === 0) {
            contenidoHtml += `<p class="text-xs text-gray-500 py-4 text-center">Aún no has agregado regalos a tu lista.</p>`;
          } else {
            items.forEach(it => {
              const esReservado = it.estado === "Reservado";
              contenidoHtml += `
                <div class="pt-3 flex items-center justify-between text-xs">
                  <div>
                    <p class="font-bold text-gray-800">${it.nombre_producto}</p>
                    <p class="text-emerald-600 font-semibold">S/ ${parseFloat(it.precio || 0).toFixed(2)}</p>
                  </div>
                  <div class="text-right">
                    <span class="px-2.5 py-1 rounded text-[11px] font-extrabold block ${esReservado ? 'bg-red-100 text-red-800 border border-red-300' : 'bg-emerald-100 text-emerald-800 border border-emerald-300'}">
                      ${esReservado ? '❌ Reservado' : '⏳ Disponible'}
                    </span>
                    ${esReservado && it.comprador ? `<span class="text-[10px] text-gray-600 mt-1 block font-medium">👤 ${it.comprador}</span>` : ''}
                  </div>
                </div>
              `;
            });
          }

          contenidoHtml += `
                </div>
                <button id="btn-cerrar-propia" class="w-full bg-slate-900 text-white text-xs py-2.5 rounded-xl font-bold cursor-pointer mt-4">Cerrar</button>
              </div>
            </div>
          `;

          const divTemp = document.createElement('div');
          divTemp.innerHTML = contenidoHtml;
          document.body.appendChild(divTemp);

          document.getElementById('cerrar-modal-propia').addEventListener('click', () => divTemp.remove());
          document.getElementById('btn-cerrar-propia').addEventListener('click', () => divTemp.remove());
        }
      } catch (e) {
        console.error(e);
        alert("Error al cargar los detalles de la lista.");
      }
    }

    document.getElementById('btn-salir-modo-invitado')?.addEventListener('click', () => {
      localStorage.removeItem('mmp_modo_invitado');
      window.location.href = window.location.pathname;
    });

    btnAbrirMenuLista?.addEventListener('click', () => drawerMenuLista?.classList.remove('translate-x-full'));
    cerrarDrawerMenu?.addEventListener('click', () => drawerMenuLista?.classList.add('translate-x-full'));

    btnAbrirRegistro?.addEventListener('click', () => {
      drawerMenuLista?.classList.add('translate-x-full');
      modalRegistroCumple?.classList.remove('hidden');
      modalRegistroCumple?.classList.add('flex');
    });

    btnCancelarRegistro?.addEventListener('click', () => {
      modalRegistroCumple?.classList.remove('flex');
      modalRegistroCumple?.classList.add('hidden');
    });

    btnCerrarSesionLista?.addEventListener('click', () => {
      localStorage.removeItem('mmp_lista_activa');
      if (seccionListaActiva) seccionListaActiva.classList.add('hidden');
      alert("Has cerrado sesión de tu lista activa.");
      window.location.reload();
    });

    formCumpleanero?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const nombreNino = document.getElementById('reg-nombre').value;
      const apellidoPat = document.getElementById('reg-pat').value;
      const apellidoMat = document.getElementById('reg-mat').value;
      const fechaCumple = document.getElementById('reg-fechacumple').value;
      const fechaCelebracion = document.getElementById('reg-fechafiesta').value;
      const celular = document.getElementById('reg-celular').value;
      const correoPrincipal = document.getElementById('reg-correoprincipal').value;
      const correoSecundario = document.getElementById('reg-correosecundario').value;

      const btnSubmit = formCumpleanero.querySelector('button[type="submit"]');
      if (btnSubmit) { btnSubmit.textContent = 'Creando...'; btnSubmit.disabled = true; }

      try {
        const response = await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({
            accion: "crear_lista",
            nombreNino, apellidoPat, apellidoMat, fechaCumple, fechaCelebracion, celular, correoPrincipal, correoSecundario
          })
        });

        const resultado = await response.json();

        if (resultado.result === "success") {
          const infoNueva = {
            id_lista: resultado.id_lista,
            codigo_acceso: resultado.codigo_acceso,
            nombreNino: nombreNino,
            items: []
          };
          localStorage.setItem('mmp_lista_activa', JSON.stringify(infoNueva));

          if (codigoGeneradoSpan) codigoGeneradoSpan.textContent = resultado.codigo_acceso;
          
          const enlaceReal = `${window.location.origin}${window.location.pathname}?lista=${resultado.id_lista}`;
          if (inputEnlaceCompartir) inputEnlaceCompartir.value = enlaceReal;

          modalRegistroCumple?.classList.remove('flex');
          modalRegistroCumple?.classList.add('hidden');
          modalExitoLista?.classList.remove('hidden');
          modalExitoLista?.classList.add('flex');
        } else {
          alert("Error: " + (resultado.message || "Inténtalo de nuevo."));
        }
      } catch (error) {
        console.error(error);
        alert("Error de conexión con el servidor.");
      } finally {
        if (btnSubmit) { btnSubmit.textContent = 'Crear Lista'; btnSubmit.disabled = false; }
      }
    });

    btnCopiarEnlace?.addEventListener('click', () => {
      if (inputEnlaceCompartir) {
        inputEnlaceCompartir.select();
        navigator.clipboard.writeText(inputEnlaceCompartir.value);
        btnCopiarEnlace.textContent = '✔️ ¡Copiado!';
        setTimeout(() => { btnCopiarEnlace.textContent = '📋 Copiar'; }, 2000);
      }
    });

    btnEmpezarAgregar?.addEventListener('click', () => {
      modalExitoLista?.classList.remove('flex');
      modalExitoLista?.classList.add('hidden');
      window.location.reload();
    });

    btnConsultarSeguimiento?.addEventListener('click', async () => {
      const codigoAcceso = inputCodigoSeguimiento?.value.trim();
      if (!codigoAcceso || codigoAcceso.length !== 6) {
        alert("Ingresa un código secreto válido de 6 dígitos.");
        return;
      }

      btnConsultarSeguimiento.textContent = "Verificando...";
      btnConsultarSeguimiento.disabled = true;

      try {
        const response = await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({ accion: "consultar_lista", codigo_acceso: codigoAcceso })
        });
        const res = await response.json();
        if (res.result === "success") {
          localStorage.setItem('mmp_lista_activa', JSON.stringify(res.lista));
          drawerMenuLista?.classList.add('translate-x-full');
          alert(`¡Bienvenido de nuevo! Has cargado la lista de ${res.lista.nombreNino}. Ya puedes administrar tus regalos.`);
          window.location.reload();
        } else {
          alert(res.message || "No se encontró ninguna lista con ese código.");
        }
      } catch (e) {
        console.error(e);
        alert("Error de conexión.");
      } finally {
        btnConsultarSeguimiento.textContent = "Ingresar";
        btnConsultarSeguimiento.disabled = false;
      }
    });
  </script>
</Layout>