  <!-- Modal Seguimiento Privado del Papá (rellenado vía DOM seguro) -->
  <div id="modal-ver-propia" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 relative shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <button type="button" id="cerrar-modal-propia" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold cursor-pointer">✕</button>
      <h3 id="titulo-modal-propia" class="text-lg font-bold text-gray-900">🎁 Seguimiento de Regalos</h3>
      <p id="subtitulo-modal-propia" class="text-xs text-gray-500"></p>
      <div id="lista-items-propia" class="space-y-3 divide-y divide-gray-100"></div>
      <button type="button" id="btn-cerrar-propia" class="w-full bg-slate-900 text-white text-xs py-2.5 rounded-xl font-bold cursor-pointer mt-4">Cerrar</button>
    </div>
  </div>

  <script>
    interface ListaActivaGuardada {
      id_lista: string;
      codigo_acceso: string;
      nombre_nino?: string;
      nombreNino?: string;
    }

    interface ListaInvitadoGuardada {
      id_lista: string;
      nombre_nino?: string;
      nombreNino?: string;
    }

    interface ItemPublicoLista {
      id_producto: string;
      estado: string;
    }

    interface ItemSeguimientoPrivado {
      id_producto: string;
      nombre_producto: string;
      precio: number;
      estado: string;
      comprador: string;
    }

    interface ProductoModalData {
      id: string;
      nombre: string;
      precio: number;
      imagen: string;
    }

    const configEl = document.getElementById('app-config');
    const APPS_SCRIPT_URL = configEl?.dataset.appsScriptUrl || '';
    const numeroWhatsApp = configEl?.dataset.numeroWhatsapp || '';

    const CLAVE_LISTA_ACTIVA = 'mmp_lista_activa';
    const CLAVE_MODO_INVITADO = 'mmp_modo_invitado';

    function leerStorageJSON<T>(clave: string): T | null {
      try {
        const raw = localStorage.getItem(clave);
        if (!raw) return null;
        return JSON.parse(raw) as T;
      } catch {
        localStorage.removeItem(clave);
        return null;
      }
    }

    function obtenerNombreLista(obj?: { nombre_nino?: string; nombreNino?: string } | null): string {
      if (!obj) return '';
      return (obj.nombre_nino || obj.nombreNino || '').trim();
    }

    function normalizarTexto(str: string): string {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    async function llamarAppsScript<T>(payload: Record<string, unknown>): Promise<T> {
      const response = await fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      if (!response.ok) {
        throw new Error(`Error de red (${response.status})`);
      }
      return (await response.json()) as T;
    }

    function actualizarScrollBloqueo() {
      const hayModalAbierto = [
        document.getElementById('modal-detalle'),
        document.getElementById('modal-registro-cumple'),
        document.getElementById('modal-exito-lista'),
        document.getElementById('modal-ver-propia')
      ].some(el => el && el.classList.contains('flex'));

      const drawer = document.getElementById('drawer-menu-lista');
      const drawerAbierto = drawer ? !drawer.classList.contains('translate-x-full') : false;

      document.body.classList.toggle('overflow-hidden', hayModalAbierto || drawerAbierto);
    }

    // --- CONTADOR REGRESIVO PARA NAVIDAD ---
    function actualizarContadorNavidad() {
      const ahora = new Date();
      const anioActual = ahora.getFullYear();
      const inicioNavidad = new Date(anioActual, 11, 25, 0, 0, 0);
      const finNavidad = new Date(anioActual, 11, 25, 23, 59, 59);

      const elDias = document.getElementById('dias');
      const elHoras = document.getElementById('horas');
      const elMinutos = document.getElementById('minutos');
      const elSegundos = document.getElementById('segundos');

      if (ahora >= inicioNavidad && ahora <= finNavidad) {
        if (elDias) elDias.textContent = '🎄';
        if (elHoras) elHoras.textContent = 'FELIZ';
        if (elMinutos) elMinutos.textContent = 'NAVI';
        if (elSegundos) elSegundos.textContent = 'DAD';
        return;
      }

      const objetivo = ahora > finNavidad ? new Date(anioActual + 1, 11, 25, 0, 0, 0) : inicioNavidad;
      const diferencia = Math.max(0, objetivo.getTime() - ahora.getTime());

      const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
      const horas = Math.floor((diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
      const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);

      if (elDias) elDias.textContent = String(dias).padStart(2, '0');
      if (elHoras) elHoras.textContent = String(horas).padStart(2, '0');
      if (elMinutos) elMinutos.textContent = String(minutos).padStart(2, '0');
      if (elSegundos) elSegundos.textContent = String(segundos).padStart(2, '0');
    }

    setInterval(actualizarContadorNavidad, 1000);
    actualizarContadorNavidad();

    // --- FILTROS, BUSCADOR Y MODO INVITADO UNIFICADOS ---
    const botonesFiltro = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtro-btn'));
    const tarjetasProductos = Array.from(document.querySelectorAll<HTMLElement>('.producto-card'));
    const contadorProductos = document.getElementById('contador-productos');
    const inputBuscador = document.getElementById('input-buscador') as HTMLInputElement | null;

    let categoriaActiva = 'todos';
    let filtroEsEspecial = false;
    let textoBusqueda = '';
    let modoInvitadoActivo = false;
    let idListaInvitadoActual = '';
    let nombreInvitadoActual = '';
    let mapaEstadosInvitado = new Map<string, string>();

    const CLASE_WP_ACTIVO =
      'btn-wp-producto bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-[9px] md:text-xs py-1.5 rounded-lg text-center transition-colors shadow-xs flex items-center justify-center';
    const CLASE_WP_RESERVADO =
      'btn-wp-producto bg-gray-300 text-gray-600 font-medium text-[9px] md:text-xs py-1.5 rounded-lg text-center flex items-center justify-center pointer-events-none cursor-not-allowed';

    function actualizarBotonWhatsAppTarjeta(card: HTMLElement, estadoInvitado?: string) {
      const btnWp = card.querySelector<HTMLAnchorElement>('.btn-wp-producto');
      if (!btnWp) return;

      const nombreProd = btnWp.dataset.nombre || '';
      const precioProd = btnWp.dataset.precio || '0.00';

      if (modoInvitadoActivo && estadoInvitado !== undefined) {
        if (estadoInvitado === 'Reservado') {
          btnWp.className = CLASE_WP_RESERVADO;
          btnWp.removeAttribute('href');
          btnWp.setAttribute('aria-disabled', 'true');
          btnWp.textContent = 'Reservado';
        } else {
          const mensajeLista = encodeURIComponent(
            `Hola, quiero reservar/comprar "${nombreProd}" (S/ ${precioProd}) de la lista de regalos de ${nombreInvitadoActual || 'celebración'} (ID: ${idListaInvitadoActual}).`
          );
          btnWp.className = CLASE_WP_ACTIVO;
          btnWp.href = `https://wa.me/${numeroWhatsApp}?text=${mensajeLista}`;
          btnWp.removeAttribute('aria-disabled');
          btnWp.textContent = 'Reservar';
        }
      } else {
        const mensajeGeneral = encodeURIComponent(
          `Hola, me interesa "${nombreProd}" de S/ ${precioProd} visto en la web.`
        );
        btnWp.className = CLASE_WP_ACTIVO;
        btnWp.href = `https://wa.me/${numeroWhatsApp}?text=${mensajeGeneral}`;
        btnWp.removeAttribute('aria-disabled');
        btnWp.textContent = 'WhatsApp';
      }
    }

    function aplicarFiltros() {
      let visibles = 0;

      tarjetasProductos.forEach(card => {
        const prodId = (card.dataset.id || '').trim();
        const etiquetaEstado = card.querySelector<HTMLElement>('.etiqueta-estado-invitado');

        if (modoInvitadoActivo) {
          if (!mapaEstadosInvitado.has(prodId)) {
            card.style.display = 'none';
            if (etiquetaEstado) etiquetaEstado.classList.add('hidden');
            return;
          }

          const estado = mapaEstadosInvitado.get(prodId) || 'Disponible';
          if (etiquetaEstado) {
            if (estado === 'Reservado') {
              etiquetaEstado.className =
                'etiqueta-estado-invitado absolute inset-x-0 bottom-0 z-30 py-2.5 px-1 text-center font-black text-xs md:text-sm shadow-lg uppercase tracking-wider bg-red-600 text-white pointer-events-none';
              etiquetaEstado.textContent = '❌ RESERVADO';
            } else {
              etiquetaEstado.className =
                'etiqueta-estado-invitado absolute inset-x-0 bottom-0 z-30 py-2 px-1 text-center font-black text-xs md:text-sm shadow-lg uppercase tracking-wider bg-emerald-600 text-white pointer-events-none';
              etiquetaEstado.textContent = '✔️ DISPONIBLE EN LISTA';
            }
          }
          actualizarBotonWhatsAppTarjeta(card, estado);
        } else {
          if (etiquetaEstado) etiquetaEstado.classList.add('hidden');
          actualizarBotonWhatsAppTarjeta(card);
        }

        const categoriaCard = normalizarTexto(card.dataset.categoria || '');
        const badgeCard = normalizarTexto(card.dataset.badge || '');
        const nombreCard = normalizarTexto(card.dataset.nombre || '');
        const tagsCard = normalizarTexto(card.dataset.tags || '');
        const filtroNorm = normalizarTexto(categoriaActiva);

        const coincideCategoria =
          filtroNorm === 'todos' ||
          (filtroEsEspecial ? badgeCard.includes(filtroNorm) : categoriaCard === filtroNorm);

        const coincideTexto =
          textoBusqueda === '' ||
          nombreCard.includes(textoBusqueda) ||
          tagsCard.includes(textoBusqueda);

        if (coincideCategoria && coincideTexto) {
          card.style.display = 'flex';
          visibles++;
        } else {
          card.style.display = 'none';
        }
      });

      if (contadorProductos) {
        contadorProductos.textContent = modoInvitadoActivo
          ? `${visibles} regalos visibles en la lista`
          : `${visibles} productos visibles`;
      }
    }

    function aplicarEstiloBotonFiltro(botonActivo: HTMLButtonElement) {
      botonesFiltro.forEach(btn => {
        const esEspecial = btn.dataset.especial === 'true';
        btn.classList.remove('bg-red-700', 'text-white', 'shadow-xs', 'bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-100', 'text-red-600', 'border-red-200', 'hover:bg-red-50');
        btn.classList.add('bg-white', 'border', 'hover:bg-gray-50');
        if (esEspecial) {
          btn.classList.add('text-red-600', 'border-red-200');
        } else {
          btn.classList.add('text-gray-700', 'border-gray-200');
        }
      });

      botonActivo.classList.remove('bg-white', 'text-gray-700', 'text-red-600', 'border', 'border-gray-200', 'border-red-200', 'hover:bg-gray-50');
      botonActivo.classList.add('bg-red-700', 'text-white', 'shadow-xs');
    }

    botonesFiltro.forEach(boton => {
      boton.addEventListener('click', () => {
        aplicarEstiloBotonFiltro(boton);
        categoriaActiva = boton.dataset.filtro || 'todos';
        filtroEsEspecial = boton.dataset.especial === 'true';
        aplicarFiltros();
      });
    });

    inputBuscador?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | null;
      textoBusqueda = normalizarTexto((target?.value || '').trim());
      aplicarFiltros();
    });

    // Evitar propagación en elementos interactivos dentro de tarjetas
    document.querySelectorAll<HTMLElement>('.stop-prop').forEach(el => {
      el.addEventListener('click', (e) => e.stopPropagation());
    });

    // Galería de miniaturas
    document.querySelectorAll<HTMLButtonElement>('.minifoto-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.dataset.target;
        const nuevaUrl = btn.dataset.url;
        if (!targetId || !nuevaUrl) return;

        const imagenPrincipal = document.getElementById(targetId) as HTMLImageElement | null;
        if (imagenPrincipal) imagenPrincipal.src = nuevaUrl;

        const card = btn.closest<HTMLElement>('.producto-card');
        card?.querySelectorAll<HTMLButtonElement>('.minifoto-btn').forEach(b => {
          b.classList.remove('border-red-500', 'scale-105');
          b.classList.add('border-white/50', 'hover:border-white');
        });
        btn.classList.remove('border-white/50', 'hover:border-white');
        btn.classList.add('border-red-500', 'scale-105');

        card?.querySelectorAll<HTMLElement>('.btn-detalle').forEach(det => {
          det.dataset.imagen = nuevaUrl;
        });
      });
    });

    // --- ZOOM Y PAN CON POINTER EVENTS ---
    const modalDetalle = document.getElementById('modal-detalle');
    const modalTitulo = document.getElementById('modal-titulo');
    const modalDesc = document.getElementById('modal-desc');
    const modalPrecio = document.getElementById('modal-precio');
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const zoomContainer = document.getElementById('zoom-container');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomResetBtn = document.getElementById('zoom-reset-btn');
    const zoomNivelSpan = document.getElementById('zoom-nivel');
    const btnAgregarDesdeDetalle = document.getElementById('btn-agregar-desde-detalle') as HTMLButtonElement | null;

    let escalaActual = 1;
    let posX = 0;
    let posY = 0;
    let arrastrandoPointer = false;
    let pointerIdActivo: number | null = null;
    let inicioX = 0;
    let inicioY = 0;
    let productoActualModal: ProductoModalData | null = null;
    let agregandoRegalo = false;

    function limitarPosicionPan() {
      if (!zoomContainer || !modalImg) return;
      const maxOffsetX = Math.max(0, ((zoomContainer.clientWidth * escalaActual) - zoomContainer.clientWidth) / 2);
      const maxOffsetY = Math.max(0, ((zoomContainer.clientHeight * escalaActual) - zoomContainer.clientHeight) / 2);
      posX = Math.min(maxOffsetX, Math.max(-maxOffsetX, posX));
      posY = Math.min(maxOffsetY, Math.max(-maxOffsetY, posY));
    }

    function actualizarTransformacion() {
      limitarPosicionPan();
      if (modalImg) {
        modalImg.style.transform = `translate(${posX}px, ${posY}px) scale(${escalaActual})`;
      }
      if (zoomNivelSpan) {
        zoomNivelSpan.textContent = `${Math.round(escalaActual * 100)}%`;
      }
    }

    function resetZoomPan() {
      escalaActual = 1;
      posX = 0;
      posY = 0;
      arrastrandoPointer = false;
      pointerIdActivo = null;
      actualizarTransformacion();
    }

    zoomInBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (escalaActual < 3) {
        escalaActual = Number((escalaActual + 0.5).toFixed(2));
        actualizarTransformacion();
      }
    });

    zoomOutBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (escalaActual > 1) {
        escalaActual = Number((escalaActual - 0.5).toFixed(2));
        if (escalaActual === 1) {
          posX = 0;
          posY = 0;
        }
        actualizarTransformacion();
      }
    });

    zoomResetBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      resetZoomPan();
    });

    zoomContainer?.addEventListener('pointerdown', (e: PointerEvent) => {
      if ((e.target as HTMLElement | null)?.closest('.zoom-control')) return;
      if (escalaActual <= 1) return;

      arrastrandoPointer = true;
      pointerIdActivo = e.pointerId;
      inicioX = e.clientX - posX;
      inicioY = e.clientY - posY;
      zoomContainer.setPointerCapture(e.pointerId);
      zoomContainer.style.cursor = 'grabbing';
    });

    zoomContainer?.addEventListener('pointermove', (e: PointerEvent) => {
      if (!arrastrandoPointer || e.pointerId !== pointerIdActivo) return;
      posX = e.clientX - inicioX;
      posY = e.clientY - inicioY;
      actualizarTransformacion();
    });

    function finalizarArrastrePointer(e: PointerEvent) {
      if (!arrastrandoPointer || e.pointerId !== pointerIdActivo) return;
      arrastrandoPointer = false;
      pointerIdActivo = null;
      if (zoomContainer && zoomContainer.hasPointerCapture(e.pointerId)) {
        zoomContainer.releasePointerCapture(e.pointerId);
      }
      if (zoomContainer) zoomContainer.style.cursor = 'grab';
    }

    zoomContainer?.addEventListener('pointerup', finalizarArrastrePointer);
    zoomContainer?.addEventListener('pointercancel', finalizarArrastrePointer);

