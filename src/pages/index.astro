---
import Layout from '../layouts/Layout.astro';

const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS2ashxyFTq07uDvUqXXB7wYYtKFrVa_bsGbrvLg5sdRhbgEzzqo2z1kIZg8n_MTve4idf-fqRAfcz8/pub?output=csv";
const numeroWhatsApp = "51982441399";
const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzYGUupwWJX0lcIDN76ytUeBopqbrqDdPGj0xq_pL4PcAVc5v-ofWXNHoOHJmW6I24hFg/exec";

interface Producto {
  id: string;
  nombre: string;
  categoria: string;
  precio: number;
  precioAnterior?: number;
  descripcion: string;
  imagen: string;
  galeria: string[];
  video?: string;
  medidas?: string;
  badge?: string;
  tags: string;
  top?: string;
  estado: string;
}

function parseRFC4180CSV(csvText: string): string[][] {
  const rows: string[][] = [];
  let currentRow: string[] = [];
  let currentField = '';
  let inQuotes = false;

  const normalized = csvText.replace(/\r\n/g, '\n').replace(/\r/g, '\n');

  for (let i = 0; i < normalized.length; i++) {
    const char = normalized[i];
    const nextChar = normalized[i + 1];

    if (char === '"') {
      if (inQuotes && nextChar === '"') {
        currentField += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === ',' && !inQuotes) {
      currentRow.push(currentField.trim());
      currentField = '';
    } else if (char === '\n' && !inQuotes) {
      currentRow.push(currentField.trim());
      if (currentRow.some(cell => cell.length > 0)) {
        rows.push(currentRow);
      }
      currentRow = [];
      currentField = '';
    } else {
      currentField += char;
    }
  }

  if (currentField.length > 0 || currentRow.length > 0) {
    currentRow.push(currentField.trim());
    if (currentRow.some(cell => cell.length > 0)) {
      rows.push(currentRow);
    }
  }

  return rows;
}

function esUrlSegura(url?: string): boolean {
  if (!url) return false;
  try {
    const parsed = new URL(url.trim());
    return parsed.protocol === 'https:' || parsed.protocol === 'http:';
  } catch {
    return false;
  }
}

function crearSlugEstable(texto: string, indice: number): string {
  const limpio = texto
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  return limpio ? `prod-${limpio}` : `prod-item-${indice}`;
}

let productos: Producto[] = [];
let errorCargaCatalogo = false;

try {
  const response = await fetch(SHEET_CSV_URL);
  if (!response.ok) {
    throw new Error(`Error HTTP al obtener CSV: ${response.status}`);
  }

  const csvText = await response.text();
  const filas = parseRFC4180CSV(csvText);

  if (filas.length > 1) {
    const cabeceras = filas[0].map(c => c.trim());

    const rawProductos = filas.slice(1).map((valores, index) => {
      const filaObj: Record<string, string> = {};
      cabeceras.forEach((cabecera, colIdx) => {
        filaObj[cabecera] = valores[colIdx] ?? '';
      });

      const precioNum = Number.parseFloat(filaObj.precio || '0');
      const precioValido = Number.isFinite(precioNum) && precioNum >= 0 ? precioNum : 0;

      const precioAntNum = Number.parseFloat(filaObj.precioAnterior || '');
      const precioAnteriorValido =
        Number.isFinite(precioAntNum) && precioAntNum > precioValido ? precioAntNum : undefined;

      const galeriaSegura = (filaObj.galeria || '')
        .split(',')
        .map((f: string) => f.trim())
        .filter((f: string) => esUrlSegura(f));

      const imagenSegura = esUrlSegura(filaObj.imagen)
        ? filaObj.imagen.trim()
        : (galeriaSegura[0] || '/logo.jpg');

      const todasFotosUnicas = Array.from(new Set([imagenSegura, ...galeriaSegura]));
      const nombreLimpiado = (filaObj.nombre || 'Producto sin nombre').trim();
      const idEstable = (filaObj.id || filaObj.codigo || '').trim() || crearSlugEstable(nombreLimpiado, index);

      return {
        id: idEstable,
        nombre: nombreLimpiado,
        categoria: (filaObj.categoria || 'General').trim(),
        precio: precioValido,
        precioAnterior: precioAnteriorValido,
        descripcion: (filaObj.descripcion || 'Producto importado de alta calidad con garantía.').trim(),
        imagen: imagenSegura,
        galeria: todasFotosUnicas,
        video: esUrlSegura(filaObj.video) ? filaObj.video.trim() : undefined,
        medidas: (filaObj.medidas || '').trim() || undefined,
        badge: (filaObj.badge || '').trim() || undefined,
        tags: (filaObj.tags || '').trim(),
        top: (filaObj.top || '').trim(),
        estado: (filaObj.estado || '').trim()
      } satisfies Producto;
    });

    productos = rawProductos.filter(item => item.estado.toLowerCase() === 'activo');

    productos.sort((a, b) => {
      const catA = a.categoria.toLowerCase();
      const catB = b.categoria.toLowerCase();
      if (catA !== catB) return catA.localeCompare(catB);

      const getTopWeight = (topStr?: string): number => {
        const t = (topStr || '').toLowerCase().trim();
        if (t === 'top1') return 1;
        if (t === 'top2') return 2;
        if (t === 'top3') return 3;
        return 99;
      };

      const pesoA = getTopWeight(a.top);
      const pesoB = getTopWeight(b.top);
      if (pesoA !== pesoB) return pesoA - pesoB;

      return a.id.localeCompare(b.id);
    });
  }
} catch (error) {
  console.error('Error al cargar Google Sheets:', error);
  errorCargaCatalogo = true;
}

const categoriasDinamicas: string[] = Array.from(
  new Set(
    productos
      .map((p: Producto) => p.categoria)
      .filter((cat: string) => cat.length > 0)
  )
);

const badgesEspeciales = [
  { filtro: 'Oferta', label: '🔥 Ofertas' },
  { filtro: 'Nuevo', label: '✨ Nuevos' },
  { filtro: 'Tendencia', label: '⭐ Tendencia' }
];
---

<Layout title="MMP | Regalos y Novedades">
  <div
    id="app-config"
    data-apps-script-url={APPS_SCRIPT_URL}
    data-numero-whatsapp={numeroWhatsApp}
    class="hidden"
  ></div>

  <!-- Contenedor sticky único para banner de invitado y cabecera -->
  <div class="sticky top-0 z-40 w-full">
    <div
      id="banner-invitado"
      class="bg-amber-500 text-slate-950 font-bold text-xs py-2 px-4 text-center hidden shadow-sm items-center justify-center flex-wrap gap-2"
    >
      <span>🎁 Estás viendo la lista de regalos de <span id="banner-nombre-cumple" class="underline">---</span></span>
      <button
        type="button"
        id="btn-salir-modo-invitado"
        class="bg-slate-950 text-white px-2.5 py-0.5 rounded text-[10px] cursor-pointer hover:bg-slate-800 transition-colors"
      >
        Salir / Ver Catálogo General
      </button>
    </div>

    <header class="bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-xs">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-2 md:gap-4">
        <div class="flex items-center gap-2 shrink-0">
          <a href="/" class="flex items-center gap-2">
            <img src="/logo.jpg" alt="MMP Tienda Online" class="h-12 md:h-14 w-auto object-contain rounded-md" />
          </a>
        </div>

        <div class="flex-1 max-w-md">
          <input
            type="text"
            id="input-buscador"
            placeholder="🔍 Buscar producto..."
            class="w-full bg-gray-50 text-gray-800 text-xs md:text-sm px-4 py-2 rounded-full border border-gray-200 focus:outline-none focus:border-red-600 shadow-xs"
          />
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            id="btn-abrir-menu-lista"
            class="bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs md:text-sm font-semibold px-3 py-2 rounded-full transition-colors cursor-pointer shadow-xs flex items-center gap-1"
          >
            🎁 Arma tu Lista / Seguimiento
          </button>

          <a
            href={`https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent('Hola, quisiera más información sobre el catálogo.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs md:text-sm font-medium px-3 md:px-4 py-2 rounded-full transition-colors shadow-xs flex items-center gap-1.5"
          >
            💬 WhatsApp
          </a>
        </div>
      </div>
    </header>
  </div>

  <!-- Banner Principal con Contador Navideño -->
  <section class="bg-gradient-to-r from-red-900 via-rose-950 to-slate-900 text-white py-8 md:py-10 px-4 text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto space-y-3 relative z-10">
      <span class="bg-red-500/30 text-red-200 text-xs font-semibold px-3 py-1 rounded-full border border-red-500/40">✨ Envíos a Todo el Perú</span>
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight">MMP - Regalos y Novedades</h1>
      <p class="text-gray-200 text-xs md:text-sm">Explora nuestros productos, arma tu lista de celebración o haz seguimiento a tus regalos con tu código secreto.</p>

      <div id="contador-navidad" class="pt-2 flex justify-center items-center gap-2 md:gap-4 text-center">
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="dias" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Días</span>
        </div>
        <span class="text-lg font-bold text-red-400">:</span>
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="horas" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Horas</span>
        </div>
        <span class="text-lg font-bold text-red-400">:</span>
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="minutos" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Min</span>
        </div>
        <span class="text-lg font-bold text-red-400">:</span>
        <div class="bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 shadow-inner">
          <span id="segundos" class="block text-base md:text-xl font-black text-amber-400 font-mono">00</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-300">Seg</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo -->
  <main class="max-w-6xl mx-auto px-2 md:px-4 py-8">
    <div
      id="aviso-lista-invalida"
      class="hidden mb-6 bg-amber-50 border border-amber-300 text-amber-900 text-xs md:text-sm px-4 py-3 rounded-xl items-center justify-between gap-2"
    >
      <span>⚠️ El enlace de lista ingresado no existe o no está disponible. Mostrando el catálogo general.</span>
      <button type="button" id="btn-cerrar-aviso-lista" class="text-amber-800 font-bold cursor-pointer">✕</button>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 px-2">
      <div>
        <h2 class="text-lg md:text-xl font-bold text-gray-900">Productos Disponibles</h2>
        <span class="text-xs md:text-sm text-gray-500" id="contador-productos">{productos.length} productos en stock</span>
      </div>

      <div class="flex flex-wrap gap-2" id="filtros-container">
        <button
          type="button"
          data-filtro="todos"
          data-especial="false"
          class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-red-700 text-white transition-colors cursor-pointer shadow-xs"
        >
          Todos
        </button>

        {categoriasDinamicas.map((cat: string) => (
          <button
            type="button"
            data-filtro={cat}
            data-especial="false"
            class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer"
          >
            {cat}
          </button>
        ))}

        {badgesEspeciales.map((b) => (
          <button
            type="button"
            data-filtro={b.filtro}
            data-especial="true"
            class="filtro-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors cursor-pointer"
          >
            {b.label}
          </button>
        ))}
      </div>
    </div>

    {errorCargaCatalogo && productos.length === 0 && (
      <div class="bg-red-50 border border-red-200 text-red-800 text-xs md:text-sm p-4 rounded-xl mb-6 text-center">
        No se pudo cargar el catálogo en este momento. Intenta recargar la página en unos minutos.
      </div>
    )}

    <!-- Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-4 md:gap-6" id="grid-productos">
      {productos.map((item: Producto, index: number) => {
        const mensajeWp = encodeURIComponent(
          `Hola, me interesa "${item.nombre}" de S/ ${item.precio.toFixed(2)} visto en la web.`
        );
        const linkWp = `https://wa.me/${numeroWhatsApp}?text=${mensajeWp}`;
        const uniqueId = `prod-${index}`;

        return (
          <div
            class="producto-card bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between"
            data-nombre={item.nombre.toLowerCase()}
            data-tags={item.tags.toLowerCase()}
            data-categoria={item.categoria.toLowerCase()}
            data-badge={(item.badge || '').toLowerCase()}
            data-id={item.id}
            data-precio-num={String(item.precio)}
          >
            <div>
              <div
                class="relative bg-gray-50 aspect-square overflow-hidden flex flex-col justify-between p-2 cursor-pointer btn-detalle group"
                data-nombre={item.nombre}
                data-desc={item.descripcion}
                data-precio={`S/ ${item.precio.toFixed(2)}`}
                data-imagen={item.imagen}
                data-id={item.id}
              >
                <div class="w-full h-full absolute inset-0 bg-gray-50 flex items-center justify-center p-2">
                  <img
                    src={item.imagen}
                    alt={item.nombre}
                    class="imagen-principal object-contain w-full h-full pointer-events-none group-hover:scale-105 transition-transform duration-300"
                    id={`img-${uniqueId}`}
                    loading="lazy"
                  />
                </div>

                {item.video && (
                  <a
                    href={item.video}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="stop-prop absolute bottom-2 left-2 z-20 bg-red-600 hover:bg-red-700 text-white p-2 rounded-full shadow-md transition-transform hover:scale-110 flex items-center justify-center"
                    title="Ver video"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </a>
                )}

                {item.badge && (
                  <span class="absolute top-2 left-2 z-10 bg-red-600 text-white text-[9px] md:text-xs font-bold px-1.5 py-0.5 rounded shadow-xs pointer-events-none">
                    {item.badge}
                  </span>
                )}

                {item.galeria.length > 1 && (
                  <div class="stop-prop relative z-10 mt-auto flex gap-1 bg-black/50 backdrop-blur-md p-1 rounded overflow-x-auto">
                    {item.galeria.map((fotoUrl: string, fotoIdx: number) => (
                      <button
                        type="button"
                        class={`minifoto-btn w-6 h-6 rounded overflow-hidden border-2 transition-all shrink-0 cursor-pointer ${
                          fotoIdx === 0 ? 'border-red-500 scale-105' : 'border-white/50 hover:border-white'
                        }`}
                        data-target={`img-${uniqueId}`}
                        data-url={fotoUrl}
                        aria-label={`Ver imagen ${fotoIdx + 1} de ${item.nombre}`}
                      >
                        <img src={fotoUrl} alt="" class="w-full h-full object-cover" />
                      </button>
                    ))}
                  </div>
                )}

                <div class="etiqueta-estado-invitado hidden absolute inset-x-0 bottom-0 z-30 py-2 px-1 text-center font-black text-xs md:text-sm shadow-lg uppercase tracking-wider pointer-events-none"></div>
              </div>

              <div class="p-2 md:p-3 flex flex-col space-y-1">
                <span class="text-[9px] md:text-xs font-semibold text-red-600 uppercase tracking-wider">{item.categoria}</span>
                <h3 class="text-xs md:text-sm font-semibold text-gray-900 line-clamp-2 leading-tight">{item.nombre}</h3>

                {item.medidas && (
                  <p class="text-[9px] md:text-xs text-gray-500 bg-gray-50 px-1.5 py-0.5 rounded border border-gray-100 inline-block">
                    📏 {item.medidas}
                  </p>
                )}
              </div>
            </div>

            <div class="p-2 md:p-3 pt-0 flex flex-col space-y-1.5">
              <div class="flex items-baseline justify-between border-t border-gray-50 pt-1.5">
                <span class="text-xs md:text-base font-bold text-gray-900">S/ {item.precio.toFixed(2)}</span>
                {item.precioAnterior !== undefined && (
                  <span class="text-[9px] md:text-xs text-gray-400 line-through">S/ {item.precioAnterior.toFixed(2)}</span>
                )}
              </div>

              <div class="grid grid-cols-2 gap-1 pt-1">
                <button
                  type="button"
                  class="btn-detalle bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-[9px] md:text-xs py-1.5 rounded-lg transition-colors text-center cursor-pointer"
                  data-nombre={item.nombre}
                  data-desc={item.descripcion}
                  data-precio={`S/ ${item.precio.toFixed(2)}`}
                  data-imagen={item.imagen}
                  data-id={item.id}
                >
                  🔍 Detalle
                </button>

                <a
                  href={linkWp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-wp-producto bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-[9px] md:text-xs py-1.5 rounded-lg text-center transition-colors shadow-xs flex items-center justify-center"
                  data-nombre={item.nombre}
                  data-precio={item.precio.toFixed(2)}
                >
                  WhatsApp
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </main>

  <!-- Footer -->
  <footer class="mt-20 border-t border-gray-200 bg-slate-900 text-gray-200 py-6 text-center text-xs">
    <p>MMP - Todos los derechos reservados.</p>
  </footer>

  <!-- Modal Detalle -->
  <div id="modal-detalle" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 relative shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <button
        type="button"
        id="cerrar-modal-btn"
        class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl font-bold cursor-pointer z-10 bg-gray-100 w-8 h-8 rounded-full flex items-center justify-center"
      >
        ✕
      </button>

      <div
        id="zoom-container"
        class="w-full h-72 md:h-80 bg-gray-50 rounded-xl overflow-hidden flex items-center justify-center p-2 relative group cursor-grab active:cursor-grabbing select-none touch-none"
      >
        <img
          id="modal-img"
          src=""
          alt=""
          draggable="false"
          class="max-w-full max-h-full object-contain transition-transform duration-75 origin-center select-none"
        />

        <div id="contenedor-btn-accion-modal" class="zoom-control absolute top-3 left-3 z-20">
          <button
            type="button"
            id="btn-agregar-desde-detalle"
            class="bg-pink-600 hover:bg-pink-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow-md transition-colors cursor-pointer flex items-center gap-1"
          >
            ❤️ Agregar a tu Lista
          </button>
        </div>

        <div class="zoom-control absolute bottom-3 right-3 z-20 flex items-center gap-1 bg-black/60 backdrop-blur-md p-1 rounded-lg text-white shadow-md">
          <button type="button" id="zoom-out-btn" class="w-7 h-7 bg-white/20 hover:bg-white/40 rounded flex items-center justify-center font-bold text-sm cursor-pointer">-</button>
          <span id="zoom-nivel" class="text-[10px] px-1 font-mono">100%</span>
          <button type="button" id="zoom-in-btn" class="w-7 h-7 bg-white/20 hover:bg-white/40 rounded flex items-center justify-center font-bold text-sm cursor-pointer">+</button>
          <button type="button" id="zoom-reset-btn" class="w-7 h-7 bg-white/20 hover:bg-white/40 rounded flex items-center justify-center font-bold text-xs cursor-pointer">↺</button>
        </div>
      </div>
      <p class="text-[10px] text-gray-400 text-center">💡 Usa [+] para acercar y arrastra la imagen para moverte.</p>

      <div>
        <span id="modal-precio" class="text-emerald-600 font-bold text-xl"></span>
        <h3 id="modal-titulo" class="text-xl font-bold text-gray-900 mt-1"></h3>
      </div>
      <p id="modal-desc" class="text-gray-600 text-sm leading-relaxed whitespace-pre-line"></p>
      <div class="pt-2">
        <button
          type="button"
          id="cerrar-modal-footer"
          class="w-full bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm py-2.5 rounded-xl transition-colors cursor-pointer"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <!-- Backdrop + Drawer Menú Principal -->
  <div id="backdrop-drawer" class="fixed inset-0 z-40 bg-black/50 backdrop-blur-xs hidden"></div>
  <div
    id="drawer-menu-lista"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="bg-red-700 text-white p-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">🎁</span>
        <h3 class="font-bold text-sm">Gestión de Listas y Regalos</h3>
      </div>
      <button type="button" id="cerrar-drawer-menu" class="text-red-200 hover:text-white text-lg font-bold cursor-pointer">✕</button>
    </div>

    <div id="drawer-contenido" class="p-6 space-y-6 flex-1 overflow-y-auto">
