    formCumpleanero?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nombreNino = (document.getElementById('reg-nombre') as HTMLInputElement | null)?.value.trim() || '';
      const apellidoPat = (document.getElementById('reg-pat') as HTMLInputElement | null)?.value.trim() || '';
      const apellidoMat = (document.getElementById('reg-mat') as HTMLInputElement | null)?.value.trim() || '';
      const fechaCumple = (document.getElementById('reg-fechacumple') as HTMLInputElement | null)?.value || '';
      const fechaCelebracion = (document.getElementById('reg-fechafiesta') as HTMLInputElement | null)?.value || '';
      const celular = (document.getElementById('reg-celular') as HTMLInputElement | null)?.value.trim() || '';
      const correoPrincipal = (document.getElementById('reg-correoprincipal') as HTMLInputElement | null)?.value.trim() || '';
      const correoSecundario = (document.getElementById('reg-correosecundario') as HTMLInputElement | null)?.value.trim() || '';

      const btnSubmit = formCumpleanero.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btnSubmit) {
        btnSubmit.textContent = 'Creando...';
        btnSubmit.disabled = true;
      }

      try {
        const urlBase = `${window.location.origin}${window.location.pathname}`;
        const resultado = await llamarAppsScript<{
          result: string;
          id_lista?: string;
          codigo_acceso?: string;
          nombre_nino?: string;
          message?: string;
        }>({
          accion: 'crear_lista',
          nombreNino,
          apellidoPat,
          apellidoMat,
          fechaCumple,
          fechaCelebracion,
          celular,
          correoPrincipal,
          correoSecundario,
          urlBase
        });

        if (resultado.result === 'success' && resultado.id_lista && resultado.codigo_acceso) {
          limpiarEstadoInvitadoUI();
          ocultarAvisoListaInvalida();
          if (window.location.search) {
            window.history.replaceState({}, '', window.location.pathname);
          }

          const nombreGuardado = (resultado.nombre_nino || nombreNino).trim();
          const infoNueva: ListaActivaGuardada = {
            id_lista: resultado.id_lista,
            codigo_acceso: resultado.codigo_acceso,
            nombre_nino: nombreGuardado
          };
          localStorage.setItem(CLAVE_LISTA_ACTIVA, JSON.stringify(infoNueva));
          refrescarPanelListaActiva();
          aplicarFiltros();

          if (codigoGeneradoSpan) codigoGeneradoSpan.textContent = resultado.codigo_acceso;

          const enlaceReal = `${window.location.origin}${window.location.pathname}?lista=${encodeURIComponent(resultado.id_lista)}`;
          if (inputEnlaceCompartir) inputEnlaceCompartir.value = enlaceReal;

          cerrarModalRegistro();
          modalExitoLista?.classList.remove('hidden');
          modalExitoLista?.classList.add('flex');
          actualizarScrollBloqueo();
        } else {
          alert('Error: ' + (resultado.message || 'Inténtalo de nuevo.'));
        }
      } catch (error) {
        console.error(error);
        alert('Error de conexión con el servidor.');
      } finally {
        if (btnSubmit) {
          btnSubmit.textContent = 'Crear Lista';
          btnSubmit.disabled = false;
        }
      }
    });

    btnCopiarEnlace?.addEventListener('click', async () => {
      if (!inputEnlaceCompartir || !inputEnlaceCompartir.value) return;
      inputEnlaceCompartir.select();

      try {
        await navigator.clipboard.writeText(inputEnlaceCompartir.value);
        btnCopiarEnlace.textContent = '✔️ ¡Copiado!';
        setTimeout(() => {
          btnCopiarEnlace.textContent = '📋 Copiar';
        }, 2000);
      } catch {
        alert('Copia el enlace manualmente desde el campo de texto.');
      }
    });

    btnEmpezarAgregar?.addEventListener('click', () => {
      cerrarModalExito();
      window.location.href = window.location.pathname;
    });

    inputCodigoSeguimiento?.addEventListener('input', () => {
      inputCodigoSeguimiento.value = inputCodigoSeguimiento.value.replace(/\D/g, '').slice(0, 6);
    });

    btnConsultarSeguimiento?.addEventListener('click', async () => {
      const codigoAcceso = (inputCodigoSeguimiento?.value || '').trim();
      if (!/^\d{6}$/.test(codigoAcceso)) {
        alert('Ingresa un código secreto válido de 6 dígitos numéricos.');
        return;
      }

      btnConsultarSeguimiento.textContent = 'Verificando...';
      btnConsultarSeguimiento.disabled = true;

      try {
        const cargado = await iniciarSesionConCodigo(codigoAcceso, true);
        if (cargado) {
          cerrarDrawer();
          if (window.location.search) {
            window.location.href = window.location.pathname;
          }
        }
      } catch (e) {
        console.error(e);
        alert('Error de conexión.');
      } finally {
        btnConsultarSeguimiento.textContent = 'Ingresar';
        btnConsultarSeguimiento.disabled = false;
      }
    });
  </script>
</Layout>