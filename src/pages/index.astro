  </div>

  <!-- Modal de Registro Directo -->
  <div id="modal-registro-cumple" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 relative shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">🎂 Datos para la Lista de Deseos</h3>

      <form id="form-cumpleanero" class="space-y-3">
