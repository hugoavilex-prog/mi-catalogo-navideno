---
import Layout from '../layouts/Layout.astro';

// Tu nuevo enlace CSV público de Google Sheets
const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS2ashxyFTq07uDvUqXXB7wYYtKFrVa_bsGbrvLg5sdRhbgEzzqo2z1kIZg8n_MTve4idf-fqRAfcz8/pub?output=csv";

const numeroWhatsApp = "51982441399";

let productos = [];

try {
  const response = await fetch(SHEET_CSV_URL);
  const csvText = await response.text();
  
  const lineas = csvText.split('\n').filter(linea => linea.trim() !== '');
  
  const parseCSVLine = (linea) => {
    const valores = [];
    let enComillas = false;
    let valorActual = '';
    
    for (let i = 0; i < linea.length; i++) {
      const char = linea[i];
      if (char === '"') {
        enComillas = !enComillas;
      } else if (char === ',' && !enComillas) {
        valores.push(valorActual.trim().replace(/^"|"$/g, ''));
        valorActual = '';
      } else {
        valorActual += char;
      }
    }
    valores.push(valorActual.trim().replace(/^"|"$/g, ''));
    return valores;
  };

  const cabeceras = parseCSVLine(lineas[0]);
  
  productos = lineas.slice(1).map(linea => {
    const valores = parseCSVLine(linea);
    const obj = {};
    cabeceras.forEach((cabecera, i) => {
      obj[cabecera] = valores[i] || '';
    });
    return obj;
  });

  // Filtramos para mostrar ÚNICAMENTE los productos que tengan estado "Activo"
  productos = productos.filter(item => item.estado && item.estado.toLowerCase() === 'activo');

} catch (error) {
  console.error("Error al cargar los productos de Google Sheets:", error);
}
---

<Layout title="Catálogo Navideño Exclusivo | Importaciones Lima y Provincias">
  <!-- Header / Barra de Navegación con Buscador -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-red-100 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
      <div class="flex items-center space-x-2 shrink-0">
        <span class="text-base md:text-xl font-bold tracking-tight text-red-700">🎄 MMP - NAVIDAD</span>
      </div>

      <!-- Buscador en tiempo real -->
      <div class="flex-1 max-w-md">
        <input 
          type="text" 
          id="input-buscador" 
          placeholder="🔍 Buscar por nombre o tag..." 
          class="w-full bg-gray-50 text-gray-800 text-xs md:text-sm px-4 py-2 rounded-full border border-gray-200 focus:outline-none focus:border-red-600 shadow-xs transition-colors"
        />
      </div>

      <a 
        href={`https://wa.me/${numeroWhatsApp}?text=Hola,%20quisiera%20más%20información%20sobre%20el%20catálogo%20navideño.`} 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs md:text-sm font-medium px-3.5 py-2 rounded-full transition-colors flex items-center gap-1.5 shrink-0 shadow-sm"
      >
        💬 WhatsApp
      </a>
    </div>
  </header>

  <!-- Banner de Campaña -->
  <section class="bg-gradient-to-r from-red-900 via-rose-950 to-emerald-950 text-white py-12 px-4 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-3xl mx-auto space-y-3 relative z-10">
      <span class="bg-red-500/30 text-red-200 text-xs font-semibold px-3 py-1 rounded-full border border-red-500/40">
        ✨ Campaña Navideña 2026
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">
        Regalos y Novedades Importadas para Esta Navidad
      </h1>
      <p class="text-gray-200 text-sm md:text-base">
        Haz tus compras con anticipación. Envíos seguros a Lima y Provincias vía Shalom y Olva Courier. 🎁
      </p>
    </div>
  </section>

  <!-- Catálogo de Productos -->
  <main class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl font-bold text-gray-900">Catálogo Disponible</h2>
        <span class="text-sm text-gray-500" id="contador-productos">{productos.length} productos en stock</span>
      </div>

      <!-- Botones de Filtro (Categorías y Etiquetas de Badge combinados) -->
      <div class="flex flex-wrap gap-2" id="filtros-container">
        <button data-filtro="todos" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-red-700 text-white transition-colors shadow-xs cursor-pointer">
          Todos
        </button>
        <button data-filtro="Juguetes" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">
          Juguetes
        </button>
        <button data-filtro="Regalos" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">
          Regalos
        </button>
        <button data-filtro="Ropa" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">
          Ropa
        </button>
        <button data-filtro="Muebles" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors cursor-pointer">
          Muebles
        </button>