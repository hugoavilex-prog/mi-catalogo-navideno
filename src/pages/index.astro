    async function cargarVistaInvitado(idListaUrl: string) {
      const bannerInvitado = document.getElementById('banner-invitado');
      const bannerNombreCumple = document.getElementById('banner-nombre-cumple');

      try {
        const resLista = await llamarAppsScript<{ result: string; lista?: ListaInvitadoGuardada }>({
          accion: 'consultar_por_id',
          id_lista: idListaUrl
        });

        if (resLista.result !== 'success' || !resLista.lista) {
          limpiarEstadoInvitadoUI();
          mostrarAvisoListaInvalida();
          aplicarFiltros();
          return;
        }

        const resItems = await llamarAppsScript<{ result: string; items?: ItemPublicoLista[] }>({
          accion: 'obtener_items_lista',
          id_lista: idListaUrl
        });

        if (resItems.result !== 'success') {
          limpiarEstadoInvitadoUI();
          mostrarAvisoListaInvalida();
          aplicarFiltros();
          return;
        }

        const nombreCumple = obtenerNombreLista(resLista.lista) || 'Invitado';
        localStorage.setItem(CLAVE_MODO_INVITADO, JSON.stringify(resLista.lista));
        modoInvitadoActivo = true;
        idListaInvitadoActual = idListaUrl;
        nombreInvitadoActual = nombreCumple;

        if (bannerNombreCumple) bannerNombreCumple.textContent = nombreCumple;
        bannerInvitado?.classList.remove('hidden');
        bannerInvitado?.classList.add('flex');
        ocultarAvisoListaInvalida();

        mapaEstadosInvitado.clear();
        if (Array.isArray(resItems.items)) {
          resItems.items.forEach(item => {
            if (item && item.id_producto) {
              mapaEstadosInvitado.set(String(item.id_producto).trim(), String(item.estado || 'Disponible').trim());
            }
          });
        }

        aplicarFiltros();
      } catch (e) {
        console.error('Error cargando lista de invitado:', e);
        limpiarEstadoInvitadoUI();
        mostrarAvisoListaInvalida();
        aplicarFiltros();
      }
    }

    function renderizarSeguimientoSeguro(items: ItemSeguimientoPrivado[], nombreNino: string, idLista: string) {
      if (tituloModalPropia) {
        tituloModalPropia.textContent = `🎁 Seguimiento: Regalos de ${nombreNino || 'Lista'}`;
      }
      if (subtituloModalPropia) {
        subtituloModalPropia.textContent = '';
        const strong = document.createElement('strong');
        strong.textContent = idLista;
        subtituloModalPropia.append('ID de Lista: ', strong);
      }
      if (!listaItemsPropia) return;

      listaItemsPropia.textContent = '';

      if (items.length === 0) {
        const vacio = document.createElement('p');
        vacio.className = 'text-xs text-gray-500 py-4 text-center';
        vacio.textContent = 'Aún no has agregado regalos a tu lista.';
        listaItemsPropia.appendChild(vacio);
        return;
      }

      items.forEach(it => {
        const esReservado = String(it.estado || '').trim() === 'Reservado';
        const precioNum = Number.isFinite(Number(it.precio)) ? Number(it.precio) : 0;

        const fila = document.createElement('div');
        fila.className = 'pt-3 flex items-center justify-between gap-3 text-xs';

        const izq = document.createElement('div');
        const pNombre = document.createElement('p');
        pNombre.className = 'font-bold text-gray-800';
        pNombre.textContent = String(it.nombre_producto || '');

        const pPrecio = document.createElement('p');
        pPrecio.className = 'text-emerald-600 font-semibold';
        pPrecio.textContent = `S/ ${precioNum.toFixed(2)}`;

        izq.append(pNombre, pPrecio);

        const der = document.createElement('div');
        der.className = 'text-right shrink-0';

        const badge = document.createElement('span');
        badge.className = esReservado
          ? 'px-2.5 py-1 rounded text-[11px] font-extrabold block bg-red-100 text-red-800 border border-red-300'
          : 'px-2.5 py-1 rounded text-[11px] font-extrabold block bg-emerald-100 text-emerald-800 border border-emerald-300';
        badge.textContent = esReservado ? '❌ Reservado' : '⏳ Disponible';
        der.appendChild(badge);

        if (esReservado && it.comprador) {
          const spanComp = document.createElement('span');
          spanComp.className = 'text-[10px] text-gray-600 mt-1 block font-medium';
          spanComp.textContent = `👤 ${String(it.comprador)}`;
          der.appendChild(spanComp);
        }

        fila.append(izq, der);
        listaItemsPropia.appendChild(fila);
      });
    }

    async function abrirModalSeguimientoPapa(listaActiva: ListaActivaGuardada) {
      if (consultandoSeguimiento) return;
      consultandoSeguimiento = true;
      const textoOriginal = btnVerMiListaPapa?.textContent || '📋 Seguimiento: Ver Quién Reservó mis Regalos';
