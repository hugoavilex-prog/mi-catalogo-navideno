      } finally {
        consultandoSeguimiento = false;
        if (btnVerMiListaPapa) {
          btnVerMiListaPapa.disabled = false;
          btnVerMiListaPapa.textContent = textoOriginal;
        }
      }
    }

    async function iniciarSesionConCodigo(codigoAcceso: string, mostrarBienvenida = true): Promise<boolean> {
      const res = await llamarAppsScript<{
        result: string;
        lista?: ListaActivaGuardada;
        message?: string;
      }>({
        accion: 'consultar_lista',
        codigo_acceso: codigoAcceso
      });

      if (res.result === 'success' && res.lista) {
        limpiarEstadoInvitadoUI();
        ocultarAvisoListaInvalida();
        const listaNormalizada: ListaActivaGuardada = {
          ...res.lista,
          codigo_acceso: res.lista.codigo_acceso || codigoAcceso
        };
        localStorage.setItem(CLAVE_LISTA_ACTIVA, JSON.stringify(listaNormalizada));
        refrescarPanelListaActiva();
        aplicarFiltros();
        if (mostrarBienvenida) {
          const nombreMostrar = obtenerNombreLista(listaNormalizada) || 'tu lista';
          alert(`¡Bienvenido de nuevo! Has cargado la lista de ${nombreMostrar}. Ya puedes administrar tus regalos.`);
        }
        return true;
      }

      alert(res.message || 'No se encontró ninguna lista con ese código.');
      return false;
    }

