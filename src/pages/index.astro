      <div id="seccion-lista-activa" class="space-y-3 pt-4 border-t border-gray-100 hidden">
        <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl flex items-center justify-between gap-2">
          <div>
            <span class="text-[10px] font-bold text-emerald-800 uppercase">Estás administrando la lista:</span>
            <p id="lbl-lista-activa-nombre" class="text-xs font-bold text-emerald-900">---</p>
