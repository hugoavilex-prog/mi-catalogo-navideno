---
import Layout from '../layouts/Layout.astro';

// Tu enlace CSV público de Google Sheets
const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS2ashxyFTq07uDvUqXXB7wYYtKFrVa_bsGbrvLg5sdRhbgEzzqo2z1kIZg8n_MTve4idf-fqRAfcz8/pub?gid=0&single=true&output=csv";

const numeroWhatsApp = "51971042806";

let productos = [];

try {
  const response = await fetch(SHEET_CSV_URL);
  const csvText = await response.text();
  
  const lineas = csvText.split('\n').filter(linea => linea.trim() !== '');
  
  const parseCSVLine = (linea) => {
    const valores = [];
    let enComillas = false;
    let valorActual = '';
    
    for (let i = 0; i < linea.length; i++) {
      const char = linea[i];
      if (char === '"') {
        enComillas = !enComillas;
      } else if (char === ',' && !enComillas) {
        valores.push(valorActual.trim().replace(/^"|"$/g, ''));
        valorActual = '';
      } else {
        valorActual += char;
      }
    }
    valores.push(valorActual.trim().replace(/^"|"$/g, ''));
    return valores;
  };

  const cabeceras = parseCSVLine(lineas[0]);
  
  productos = lineas.slice(1).map(linea => {
    const valores = parseCSVLine(linea);
    const obj = {};
    cabeceras.forEach((cabecera, i) => {
      obj[cabecera] = valores[i] || '';
    });
    return obj;
  });

  // Filtramos para mostrar ÚNICAMENTE los productos que tengan estado "Activo"
  productos = productos.filter(item => item.estado && item.estado.toLowerCase() === 'activo');

} catch (error) {
  console.error("Error al cargar los productos de Google Sheets:", error);
}
---

<Layout title="Catálogo Navideño Exclusivo | Importaciones Lima y Provincias">
  <!-- Header / Barra de Navegación -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-red-100 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="text-xl font-bold tracking-tight text-red-700">🎄 MMP - ESPECIAL NAVIDAD</span>
      </div>
      <a 
        href={`https://wa.me/${numeroWhatsApp}?text=Hola,%20quisiera%20más%20información%20sobre%20el%20catálogo%20navideño.`} 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-full transition-colors flex items-center gap-2 shadow-sm"
      >
        💬 Consultas WhatsApp
      </a>
    </div>
  </header>

  <!-- Banner de Campaña -->
  <section class="bg-gradient-to-r from-red-900 via-rose-950 to-emerald-950 text-white py-12 px-4 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-3xl mx-auto space-y-3 relative z-10">
      <span class="bg-red-500/30 text-red-200 text-xs font-semibold px-3 py-1 rounded-full border border-red-500/40">
        ✨ Campaña Navideña 2026
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">
        Regalos y Novedades Importadas para Esta Navidad
      </h1>
      <p class="text-gray-200 text-sm md:text-base">
        Haz tus compras con anticipación. Envíos seguros a Lima y Provincias vía Shalom y Olva Courier. 🎁
      </p>
    </div>
  </section>

  <!-- Catálogo de Productos -->
  <main class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl font-bold text-gray-900">Catálogo Disponible</h2>
        <span class="text-sm text-gray-500" id="contador-productos">{productos.length} productos en stock</span>
      </div>

      <!-- Botones de Filtro (Categorías y Etiquetas de Badge combinados) -->
      <div class="flex flex-wrap gap-2" id="filtros-container">
        <button data-filtro="todos" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-red-700 text-white transition-colors shadow-xs">
          Todos
        </button>
        <button data-filtro="Juguetes" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors">
          Juguetes
        </button>
        <button data-filtro="Regalos" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors">
          Regalos
        </button>
        <button data-filtro="Ropa" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors">
          Ropa
        </button>
        <button data-filtro="Muebles" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors">
          Muebles
        </button>
        <button data-filtro="Carteras" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition-colors">
          Carteras
        </button>
        <button data-filtro="Oferta" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors">
          🔥 Ofertas
        </button>
        <button data-filtro="Nuevo" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors">
          ✨ Nuevos
        </button>
        <button data-filtro="Tendencia" class="filtro-btn px-4 py-2 text-xs font-semibold rounded-full bg-white text-red-600 border border-red-200 hover:bg-red-50 transition-colors">
          ⭐ Tendencia
        </button>
      </div>
    </div>

    <!-- Cuadrícula de Productos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6" id="grid-productos">
      {productos.map((item) => {
        const precioNum = parseFloat(item.precio) || 0;
        const mensajeWp = encodeURIComponent(`Hola, me interesa el producto "${item.nombre}" (Medidas: ${item.medidas || 'N/D'}) con precio de S/ ${precioNum.toFixed(2)} visto en la web navideña. ¿Hay stock disponible?`);
        const linkWp = `https://wa.me/${numeroWhatsApp}?text=${mensajeWp}`;

        const fotosGaleria = item.galeria ? item.galeria.split(',').map(f => f.trim()).filter(Boolean) : [];
        const todasLasFotos = [item.imagen, ...fotosGaleria];

        return (
          <div 
            class="producto-card bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col"
            data-categoria={item.categoria}
            data-badge={item.badge}
          >
            <!-- Imagen Principal y Galería -->
            <div class="relative bg-gray-50 aspect-square overflow-hidden flex flex-col justify-between p-3">
              <div class="w-full h-full absolute inset-0 bg-gray-50 flex items-center justify-center p-4">
                <img 
                  src={item.imagen} 
                  alt={item.nombre} 
                  class="imagen-principal object-contain w-full h-full cursor-zoom-in transition-all duration-300"
                  id={`img-principal-${item.id}`}
                  data-zoomable="true"
                  loading="lazy"
                />
              </div>

              {item.badge && (
                <span class="absolute top-3 left-3 z-10 bg-red-600 text-white text-xs font-bold px-2.5 py-1 rounded-md shadow-xs">
                  {item.badge}
                </span>
              )}

              {todasLasFotos.length > 1 && (
                <div class="relative z-10 mt-auto flex gap-1.5 bg-black/50 backdrop-blur-md p-1.5 rounded-lg overflow-x-auto">
                  {todasLasFotos.map((fotoUrl, index) => (
                    <button 
                      type="button"
                      class={`minifoto-btn w-9 h-9 rounded-md overflow-hidden border-2 transition-all shrink-0 focus:outline-hidden cursor-pointer ${index === 0 ? 'border-red-500 scale-105' : 'border-white/50 hover:border-white'}`}
                      data-target={`img-principal-${item.id}`}
                      data-url={fotoUrl}
                    >
                      <img src={fotoUrl} alt="" class="w-full h-full object-cover" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Contenido de la Card -->
            <div class="p-5 flex flex-col flex-grow justify-between space-y-4">
              <div class="mt-2 space-y-1">
                <span class="text-xs font-semibold text-red-600 uppercase tracking-wider">{item.categoria}</span>
                <h3 class="text-base font-semibold text-gray-900 line-clamp-2">{item.nombre}</h3>
                
                {item.medidas && (
                  <p class="text-xs text-gray-500 bg-gray-50 px-2 py-1 rounded-md inline-block border border-gray-100">
                    📏 Medidas: <span class="font-medium text-gray-700">{item.medidas}</span>
                  </p>
                )}
              </div>

              <div class="flex items-baseline justify-between pt-2 border-t border-gray-50">
                <div>
                  <span class="text-lg font-bold text-gray-900">S/ {precioNum.toFixed(2)}</span>
                  {item.precioAnterior && (
                    <span class="text-xs text-gray-400 line-through ml-2">S/ {parseFloat(item.precioAnterior).toFixed(2)}</span>
                  )}
                </div>
              </div>

              <a 
                href={linkWp}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm py-2.5 rounded-xl text-center transition-colors flex items-center justify-center gap-2 shadow-sm"
              >
                Pedir por WhatsApp
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </main>

  <!-- Modal Interactivo con Botones de Zoom (+ y -) -->
  <div id="zoom-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex-col items-center justify-center p-4">
    <!-- Barra de Controles de Zoom -->
    <div class="absolute top-4 flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20 shadow-lg z-50">
      <button id="zoom-in" class="text-white font-bold px-3 py-1 bg-white/20 hover:bg-white/40 rounded-full transition-colors text-lg cursor-pointer" title="Acercar">+</button>
      <button id="zoom-out" class="text-white font-bold px-3 py-1 bg-white/20 hover:bg-white/40 rounded-full transition-colors text-lg cursor-pointer" title="Alejar">-</button>
      <button id="zoom-reset" class="text-white text-xs px-3 py-1.5 bg-red-600 hover:bg-red-700 rounded-full transition-colors font-medium cursor-pointer">Restablecer</button>
      <button id="cerrar-zoom" class="text-white text-lg font-bold bg-white/20 hover:bg-red-600 w-8 h-8 rounded-full flex items-center justify-center transition-colors ml-2 cursor-pointer" title="Cerrar">✕</button>
    </div>

    <!-- Contenedor de la Imagen con Zoom Dinámico -->
    <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
      <img id="imagen-zoom-src" src="" alt="Zoom producto" class="max-h-[85vh] max-w-[85vw] object-contain rounded-lg shadow-2xl transition-transform duration-200 select-none cursor-grab active:cursor-grabbing" style="transform: scale(1);" />
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-slate-900 text-gray-300 border-t border-red-900/30 mt-20 py-8 px-4 text-center text-xs">
    <div class="max-w-6xl mx-auto space-y-2">
      <p class="font-medium text-white">🎄 Aceptamos Yape, Plin y Transferencias BCP / Interbank</p>
      <p>Despachos garantizados a Lima Metropolitana y agencias de envío a Provincias.</p>
      <p class="pt-4 text-gray-500">© 2026 MMP - Especial Navideño. Todos los derechos reservados.</p>
    </div>
  </footer>

  <!-- Script para filtros, galería interactiva y zoom con controles de acercar/alejar -->
  <script>
    const botonesFiltro = document.querySelectorAll('.filtro-btn');
    const tarjetasProductos = document.querySelectorAll('.producto-card');
    const contadorProductos = document.getElementById('contador-productos');

    botonesFiltro.forEach(boton => {
      boton.addEventListener('click', () => {
        botonesFiltro.forEach(b => {
          b.classList.remove('bg-red-700', 'text-white');
          b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        });
        boton.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'text-red-600', 'border-red-200');
        boton.classList.add('bg-red-700', 'text-white');

        const filtroSeleccionado = boton.getAttribute('data-filtro');
        let visibles = 0;

        tarjetasProductos.forEach(card => {
          const categoriaCard = card.getAttribute('data-categoria');
          const badgeCard = card.getAttribute('data-badge');

          if (
            filtroSeleccionado === 'todos' || 
            categoriaCard === filtroSeleccionado || 
            badgeCard === filtroSeleccionado
          ) {
            card.style.display = 'flex';
            visibles++;
          } else {
            card.style.display = 'none';
          }
        });

        if (contadorProductos) {
          contadorProductos.textContent = `${visibles} productos en stock`;
        }
      });
    });

    // Galería interactiva
    document.querySelectorAll('.minifoto-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-target');
        const nuevaUrl = btn.getAttribute('data-url');
        
        const imagenPrincipal = document.getElementById(targetId);
        if (imagenPrincipal) {
          imagenPrincipal.setAttribute('src', nuevaUrl);
        }

        const contenedorMini = btn.parentElement;
        if (contenedorMini) {
          contenedorMini.querySelectorAll('.minifoto-btn').forEach(b => {
            b.classList.remove('border-red-500', 'scale-105');
            b.classList.add('border-white/50');
          });
          btn.classList.add('border-red-500', 'scale-105');
          btn.classList.remove('border-white/50');
        }
      });
    });

    // Zoom Modal Avanzado con Botones de Acercar / Alejar
    const zoomModal = document.getElementById('zoom-modal');
    const imagenZoomSrc = document.getElementById('imagen-zoom-src') as HTMLImageElement;
    const btnZoomIn = document.getElementById('zoom-in');
    const btnZoomOut = document.getElementById('zoom-out');
    const btnZoomReset = document.getElementById('zoom-reset');
    const cerrarZoom = document.getElementById('cerrar-zoom');

    let escalaActual = 1;

    function actualizarZoom() {
      if (imagenZoomSrc) {
        imagenZoomSrc.style.transform = `scale(${escalaActual})`;
      }
    }

    document.querySelectorAll('img[data-zoomable="true"]').forEach(img => {
      img.addEventListener('click', (e) => {
        e.stopPropagation();
        const src = img.getAttribute('src');
        if (src && zoomModal && imagenZoomSrc) {
          imagenZoomSrc.src = src;
          escalaActual = 1; // Reiniciar zoom al abrir
          actualizarZoom();
          zoomModal.classList.remove('hidden');
          zoomModal.classList.add('flex');
        }
      });
    });

    if (btnZoomIn) {
      btnZoomIn.addEventListener('click', () => {
        if (escalaActual < 3) { // Límite máximo de acercamiento
          escalaActual += 0.3;
          actualizarZoom();
        }
      });
    }

    if (btnZoomOut) {
      btnZoomOut.addEventListener('click', () => {
        if (escalaActual > 1) { // Límite mínimo (escala normal)
          escalaActual -= 0.3;
          actualizarZoom();
        }
      });
    }

    if (btnZoomReset) {
      btnZoomReset.addEventListener('click', () => {
        escalaActual = 1;
        actualizarZoom();
      });
    }

    function cerrarModalZoom() {
      if (zoomModal) {
        zoomModal.classList.remove('flex');
        zoomModal.classList.add('hidden');
      }
    }

    if (cerrarZoom) {
      cerrarZoom.addEventListener('click', cerrarModalZoom);
    }

    if (zoomModal) {
      zoomModal.addEventListener('click', (e) => {
        // Cierra si hacen clic fuera de la imagen (en el fondo oscuro)
        if (e.target === zoomModal) {
          cerrarModalZoom();
        }
      });
    }
  </script>
</Layout>