<script>
  const botonesFiltro = document.querySelectorAll('.filtro-btn');
  const tarjetasProductos = document.querySelectorAll('.producto-card');
  const contadorProductos = document.getElementById('contador-productos');
  const inputBuscador = document.getElementById('input-buscador') as HTMLInputElement;

  let categoriaActiva = 'todos';
  let textoBusqueda = '';

  // Función centralizada para filtrar productos (por categoría/badge Y por buscador)
  function aplicarFiltros() {
    let visibles = 0;

    tarjetasProductos.forEach(card => {
      const categoriaCard = card.getAttribute('data-categoria') || '';
      const badgeCard = card.getAttribute('data-badge') || '';
      const nombreCard = card.getAttribute('data-nombre') || '';
      const tagsCard = card.getAttribute('data-tags') || '';

      // 1. Validar filtro de categoría o badge
      const coincideCategoria = (
        categoriaActiva === 'todos' || 
        categoriaCard.toLowerCase() === categoriaActiva.toLowerCase() || 
        badgeCard.toLowerCase() === categoriaActiva.toLowerCase()
      );

      // 2. Validar buscador de texto (busca en nombre o en tags)
      const coincideTexto = (
        nombreCard.includes(textoBusqueda) || 
        tagsCard.includes(textoBusqueda)
      );

      if (coincideCategoria && coincideTexto) {
        (card as HTMLElement).style.display = 'flex';
        visibles++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (contadorProductos) {
      contadorProductos.textContent = `${visibles} productos en stock`;
    }
  }

  // Evento para los botones de categoría
  botonesFiltro.forEach(boton => {
    boton.addEventListener('click', () => {
      botonesFiltro.forEach(b => {
        b.classList.remove('bg-red-700', 'text-white');
        b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      });
      boton.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'text-red-600', 'border-red-200');
      boton.classList.add('bg-red-700', 'text-white');

      categoriaActiva = boton.getAttribute('data-filtro') || 'todos';
      aplicarFiltros();
    });
  });

  // Evento para el buscador en tiempo real
  if (inputBuscador) {
    inputBuscador.addEventListener('input', (e) => {
      textoBusqueda = (e.target as HTMLInputElement).value.toLowerCase().trim();
      aplicarFiltros();
    });
  }

  // Galería interactiva
  document.querySelectorAll('.minifoto-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-target');
      const nuevaUrl = btn.getAttribute('data-url');
      
      const imagenPrincipal = document.getElementById(targetId);
      if (imagenPrincipal) {
        imagenPrincipal.setAttribute('src', nuevaUrl);
      }

      const contenedorMini = btn.parentElement;
      if (contenedorMini) {
        contenedorMini.querySelectorAll('.minifoto-btn').forEach(b => {
          b.classList.remove('border-red-500', 'scale-105');
          b.classList.add('border-white/50');
        });
        btn.classList.add('border-red-500', 'scale-105');
        btn.classList.remove('border-white/50');
      }
    });
  });

  // Funciones del Modal de Detalles
  (window as any).abrirModal = function(nombre: string, descripcion: string, precio: string, imagen: string) {
    const tituloEl = document.getElementById('modal-titulo');
    const descEl = document.getElementById('modal-desc');
    const precioEl = document.getElementById('modal-precio');
    const imgEl = document.getElementById('modal-img') as HTMLImageElement;
    const modal = document.getElementById('modal-detalle');

    if (tituloEl) tituloEl.innerText = nombre;
    if (descEl) descEl.innerText = descripcion;
    if (precioEl) precioEl.innerText = precio;
    if (imgEl) imgEl.src = imagen;

    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  };

  (window as any).cerrarModal = function() {
    const modal = document.getElementById('modal-detalle');
    if (modal) {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }
  };

  // Zoom Modal Avanzado
  const zoomModal = document.getElementById('zoom-modal');
  const imagenZoomSrc = document.getElementById('imagen-zoom-src') as HTMLImageElement;
  const btnZoomIn = document.getElementById('zoom-in');
  const btnZoomOut = document.getElementById('zoom-out');
  const btnZoomReset = document.getElementById('zoom-reset');
  const cerrarZoom = document.getElementById('cerrar-zoom');

  let escalaActual = 1;

  function actualizarZoom() {
    if (imagenZoomSrc) {
      imagenZoomSrc.style.transform = `scale(${escalaActual})`;
    }
  }

  document.querySelectorAll('img[data-zoomable="true"]').forEach(img => {
    img.addEventListener('click', (e) => {
      e.stopPropagation();
      const src = img.getAttribute('src');
      if (src && zoomModal && imagenZoomSrc) {
        imagenZoomSrc.src = src;
        escalaActual = 1; 
        actualizarZoom();
        zoomModal.classList.remove('hidden');
        zoomModal.classList.add('flex');
      }
    });
  });

  if (btnZoomIn) {
    btnZoomIn.addEventListener('click', () => {
      if (escalaActual < 3) {
        escalaActual += 0.3;
        actualizarZoom();
      }
    });
  }

  if (btnZoomOut) {
    btnZoomOut.addEventListener('click', () => {
      if (escalaActual > 1) {
        escalaActual -= 0.3;
        actualizarZoom();
      }
    });
  }

  if (btnZoomReset) {
    btnZoomReset.addEventListener('click', () => {
      escalaActual = 1;
      actualizarZoom();
    });
  }

  function cerrarModalZoom() {
    if (zoomModal) {
      zoomModal.classList.remove('flex');
      zoomModal.classList.add('hidden');
    }
  }

  if (cerrarZoom) {
    cerrarZoom.addEventListener('click', cerrarModalZoom);
  }

  if (zoomModal) {
    zoomModal.addEventListener('click', (e) => {
      if (e.target === zoomModal) {
        cerrarModalZoom();
      }
    });
  }
</script>